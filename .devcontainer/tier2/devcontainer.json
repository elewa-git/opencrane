{
  "name": "OpenCrane Tier 2",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
      "version": "28.5.1",
      "moby": true
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "16gb"
  },
  "forwardPorts": [4200],
  "portsAttributes": {
    "4200": {
      "label": "OpenCrane Tier 2 private browser",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postCreateCommand": "npm ci",
  "remoteUser": "node"
}
