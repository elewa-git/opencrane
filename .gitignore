node_modules/
dist/
.angular/
.env
.env.*
!.env.example

# Secrets / credentials — never commit key material (it must flow via k8s existingSecret).
# The leaked Zitadel SA key was a *.json service-account key; block that shape + common kinds.
*.pem
*.key
*-key.json
*service-account*.json
*serviceaccount*.json
*credentials*.json
kubeconfig
*.kubeconfig

coverage/
.DS_Store
*.tsbuildinfo
.turbo/
.vscode/
.idea/
*.log
__pycache__/
*.py[cod]

# Dev (root-level scratch dir only; anchored so it doesn't swallow nested dirs
# like apps/_infra/deploy-k8s/platform/terraform/environments/dev/)
/dev/

# Claude Code local review-gate state
.claude/.last-review-hash
.claude/.review-context.md
pr-stack-integrity-evidence.json
.nx/

# Rag-rat keeps its shared index outside the checkout; Git must also ignore local overrides and logs.
.rag-rat/

# Terraform runtime state and downloaded providers. Provider selections stay tracked in
# apps/_infra/deploy-k8s/platform/terraform/.terraform.lock.hcl.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Private agent review artifacts and R0 secured evidence packs.
/.agent-reviews/
/.r0-estate-evidence*/
/.r0-evidence*/

/keys/*

# Umbrella subchart packaging is derived from the in-repo sources at render time.
apps/_infra/deploy-k8s/Chart.lock
apps/_infra/deploy-k8s/charts/
