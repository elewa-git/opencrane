{
  "name": "deploy-k8s",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:app", "layer:entrypoint", "scope:deployment"],
  "targets": {
    "helm-lint": {
      "executor": "nx:run-commands",
      "options": { "command": "helm lint apps/_infra/deploy-k8s" }
    },
    "dependency-status": {
      "executor": "nx:run-commands",
      "options": { "command": "helm dependency list apps/_infra/deploy-k8s" }
    },
    "runtime-identity-negative-tests": {
      "executor": "nx:run-commands",
      "options": { "command": "bash scripts/runtime-identity-negative-tests.sh" }
    },
    "cilium-runtime-profile-contract": {
      "executor": "nx:run-commands",
      "options": { "command": "bash scripts/cilium-runtime-profile-contract.sh" }
    },
    "cilium-runtime-profile-live": {
      "executor": "nx:run-commands",
      "options": { "command": "bash apps/_infra/deploy-k8s/platform/tests/cilium-runtime-profile-live.sh" }
    }
  }
}
