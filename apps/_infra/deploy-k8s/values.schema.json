{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenCrane Helm values coherence guards",
  "description": "Fail-fast guards for the clean OpenCrane target. Only selected values are constrained; Helm validates merged values on every install, template, and lint.",
  "type": "object",
  "properties": {
    "controlPlaneSpa": {
      "type": "object",
      "required": ["image", "replicas", "service"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "service": {
          "type": "object",
          "required": ["port"],
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "memoryGateway": {
      "type": "object",
      "required": ["image", "replicas", "service", "projectedTokenTtlSeconds", "httpTimeoutSeconds", "kubernetesApiServerCidrs", "kubernetesApiServerPort", "kubernetesApiServerEndpointCidrs", "kubernetesApiServerEndpointPort"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 3 },
        "service": {
          "type": "object",
          "required": ["port"],
          "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
        },
        "projectedTokenTtlSeconds": { "type": "integer", "minimum": 600, "maximum": 3600 },
        "httpTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "kubernetesApiServerCidrs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/(32|128)$" },
          "uniqueItems": true
        },
        "kubernetesApiServerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "kubernetesApiServerEndpointCidrs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/(32|128)$" },
          "uniqueItems": true
        },
        "kubernetesApiServerEndpointPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "historyStore": {
      "type": "object",
      "properties": {
        "kurrentdb": {
          "type": "object",
          "required": ["bootstrapOps", "serviceCredential", "bootstrap", "probes", "podDisruptionBudget", "backup"],
          "properties": {
            "dnsResolverCidrs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$|^[0-9a-fA-F:]*:[0-9a-fA-F:]*/128$"
              }
            },
            "bootstrapOps": {
              "type": "object",
              "required": ["existingSecret"],
              "properties": {
                "existingSecret": { "type": "string", "maxLength": 253 }
              }
            },
            "serviceCredential": {
              "type": "object",
              "required": ["existingSecret"],
              "properties": {
                "existingSecret": { "type": "string", "maxLength": 253 }
              }
            },
            "bootstrap": {
              "type": "object",
              "required": ["image", "resources", "activeDeadlineSeconds", "backoffLimit", "timeoutSeconds"],
              "properties": {
                "image": {
                  "type": "object",
                  "required": ["repository", "digest", "pullPolicy"],
                  "properties": {
                    "repository": { "type": "string" },
                    "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
                    "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
                  }
                },
                "resources": {
                  "type": "object",
                  "required": ["requests", "limits"],
                  "properties": {
                    "requests": {
                      "type": "object",
                      "required": ["cpu", "memory"],
                      "properties": {
                        "cpu": { "type": "string", "pattern": "^[1-9][0-9]*m?$" },
                        "memory": { "type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi)$" }
                      }
                    },
                    "limits": {
                      "type": "object",
                      "required": ["cpu", "memory"],
                      "properties": {
                        "cpu": { "type": "string", "pattern": "^[1-9][0-9]*m?$" },
                        "memory": { "type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi)$" }
                      }
                    }
                  }
                },
                "activeDeadlineSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
                "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
                "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3599 }
              }
            },
            "probes": {
              "type": "object",
              "required": ["readiness", "liveness"],
              "properties": {
                "readiness": { "$ref": "#/definitions/kurrentdbProbe" },
                "liveness": { "$ref": "#/definitions/kurrentdbProbe" }
              }
            },
            "podDisruptionBudget": {
              "type": "object",
              "required": ["enabled", "minAvailable"],
              "properties": {
                "enabled": { "type": "boolean" },
                "minAvailable": { "type": "integer", "minimum": 0, "maximum": 3 }
              }
            },
            "backup": {
              "type": "object",
              "required": ["enabled", "mode", "schedule", "startingDeadlineSeconds", "activeDeadlineSeconds", "retention", "archive", "volumeSnapshot", "resources"],
              "properties": {
                "enabled": { "type": "boolean" },
                "mode": { "type": "string", "enum": ["fileCopy", "volumeSnapshot"] },
                "schedule": {
                  "type": "string",
                  "description": "Five-field cron expression or @hourly/@daily/@midnight/@weekly/@monthly, evaluated by the CronJob controller.",
                  "pattern": "^(@(hourly|daily|midnight|weekly|monthly)|(\\S+\\s+){4}\\S+)$"
                },
                "startingDeadlineSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
                "activeDeadlineSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
                "retention": {
                  "type": "object",
                  "required": ["keepLast"],
                  "properties": { "keepLast": { "type": "integer", "minimum": 1, "maximum": 365 } }
                },
                "archive": {
                  "type": "object",
                  "required": ["persistence"],
                  "properties": {
                    "persistence": {
                      "type": "object",
                      "required": ["storageClassName", "size"],
                      "properties": {
                        "storageClassName": { "type": "string", "maxLength": 253 },
                        "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" }
                      }
                    }
                  }
                },
                "volumeSnapshot": {
                  "type": "object",
                  "required": ["className", "readyTimeoutSeconds", "image", "kubernetesApiServerCidrs", "kubernetesApiServerPort", "kubernetesApiServerEndpointCidrs", "kubernetesApiServerEndpointPort"],
                  "properties": {
                    "className": { "type": "string", "maxLength": 253 },
                    "readyTimeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
                    "image": {
                      "type": "object",
                      "required": ["repository", "digest", "pullPolicy"],
                      "properties": {
                        "repository": { "type": "string" },
                        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
                        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
                      }
                    },
                    "kubernetesApiServerCidrs": { "$ref": "#/definitions/exactCidrList" },
                    "kubernetesApiServerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
                    "kubernetesApiServerEndpointCidrs": { "$ref": "#/definitions/exactCidrList" },
                    "kubernetesApiServerEndpointPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
                  }
                },
                "resources": {
                  "type": "object",
                  "required": ["requests", "limits"],
                  "properties": {
                    "requests": {
                      "type": "object",
                      "required": ["cpu", "memory"],
                      "properties": {
                        "cpu": { "type": "string", "pattern": "^[1-9][0-9]*m?$" },
                        "memory": { "type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi)$" }
                      }
                    },
                    "limits": {
                      "type": "object",
                      "required": ["cpu", "memory"],
                      "properties": {
                        "cpu": { "type": "string", "pattern": "^[1-9][0-9]*m?$" },
                        "memory": { "type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi)$" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "agentSandbox": {
      "type": "object",
      "required": ["enabled", "namespace", "runtimeClassName", "serviceAccountName", "profiles"],
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "runtimeClassName": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "serviceAccountName": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "poolName", "warmReplicas", "image", "resources"],
            "properties": {
              "warmReplicas": { "type": "integer", "const": 0, "description": "Computers start only after a lease is admitted; idle prewarming is unsupported." },
              "name": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
              "poolName": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
              "image": {
                "type": "object",
                "required": ["repository", "digest", "pullPolicy"],
                "properties": {
                  "repository": { "type": "string", "minLength": 1 },
                  "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
                  "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
                }
              },
              "resources": {
                "type": "object",
                "required": ["requests", "limits"],
                "properties": {
                  "requests": {
                    "type": "object",
                    "required": ["cpu", "memory"],
                    "properties": {
                      "cpu": { "type": "string", "pattern": "^[1-9][0-9]*m?$" },
                      "memory": { "type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi)$" }
                    }
                  },
                  "limits": {
                    "type": "object",
                    "required": ["cpu", "memory"],
                    "properties": {
                      "cpu": { "type": "string", "pattern": "^[1-9][0-9]*m?$" },
                      "memory": { "type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi)$" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "agentController": {
      "type": "object",
      "required": ["enabled", "image", "kubernetesApiServerCidrs", "kubernetesApiServerPort", "kubernetesApiServerEndpointCidrs", "kubernetesApiServerEndpointPort"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "required": ["repository", "digest", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "digest": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "kubernetesApiServerCidrs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/(32|128)$" },
          "uniqueItems": true
        },
        "kubernetesApiServerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "kubernetesApiServerEndpointCidrs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/(32|128)$" },
          "uniqueItems": true
        },
        "kubernetesApiServerEndpointPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "crds": {
      "type": "object",
      "description": "Install the ClusterTenant CRD via templates/crds/. Default true; set false only when a shared CRD bundle owns it.",
      "properties": {
        "install": {
          "type": "boolean",
          "description": "Render templates/crds/*.yaml (each carries helm.sh/resource-policy: keep so helm uninstall never deletes a CRD other silos still depend on)."
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "description": "External Secrets Operator integration. Off by default; when enabled, templates/external-secrets-store.yaml renders the (Cluster)SecretStore + its ServiceAccount for a standalone silo.",
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": {
          "type": "string",
          "description": "Only gcp-secret-manager has a provider block implemented today; azure-key-vault/aws-secrets-manager fail fast at render time until their provider block is added."
        },
        "serviceAccountAnnotations": { "type": "object" },
        "gcp": {
          "type": "object",
          "properties": {
            "projectId": { "type": "string" },
            "clusterLocation": { "type": "string" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "mainNetworkDefaultDeny": {
          "type": "object",
          "description": "Platform-namespace default-deny floor (templates/networkpolicy-main-default-deny.yaml). Off by default; validate plane-to-plane connectivity before enabling in production. Mandatory (enforced by a Helm fail guard) when multiCt.enabled=true.",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    }
  },
  "definitions": {
    "kurrentdbProbe": {
      "type": "object",
      "required": ["initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0, "maximum": 600 },
        "periodSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "failureThreshold": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "exactCidrList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/(32|128)$" },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["agentController"],
        "properties": {
          "agentController": {
            "required": ["enabled"],
            "properties": { "enabled": { "const": true } }
          }
        }
      },
      "then": {
        "properties": {
          "agentController": {
            "properties": {
              "kubernetesApiServerCidrs": { "minItems": 1 },
              "image": {
                "properties": {
                  "digest": { "pattern": "^sha256:[a-f0-9]{64}$" }
                }
              },
              "runtimeProfile": {
                "properties": {
                  "image": {
                    "properties": {
                      "digest": { "pattern": "^sha256:[a-f0-9]{64}$" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["externalSecrets"],
        "properties": {
          "externalSecrets": {
            "required": ["enabled"],
            "properties": {
              "enabled": { "const": true }
            }
          }
        }
      },
      "then": {
        "description": "When externalSecrets.enabled=true, a provider must be named — otherwise the (Cluster)SecretStore this chart renders has no backend to bind to and fails fast at apply time instead of install time.",
        "properties": {
          "externalSecrets": {
            "required": ["provider"],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
