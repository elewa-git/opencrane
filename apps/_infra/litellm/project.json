{
  "name": "litellm",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["backend-server-model-routing"],
  "tags": ["type:app", "layer:entrypoint", "scope:litellm"],
  "targets": {
    "helm-lint": {
      "executor": "nx:run-commands",
      "options": { "command": "helm lint apps/_infra/litellm/helm" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test local-development/*.test.mjs",
        "cwd": "apps/_infra/litellm"
      }
    }
  }
}
