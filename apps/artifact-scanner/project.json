{
  "name": "artifact-scanner",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "metadata": { "release": { "adaptedVersion": "0.8.0" } },
  "sourceRoot": "apps/artifact-scanner/src",
  "tags": ["type:app", "layer:entrypoint", "scope:artifacts"],
  "targets": {
    "build": { "executor": "nx:run-commands", "outputs": ["{workspaceRoot}/dist/apps/artifact-scanner"], "options": { "command": "rm -rf dist/apps/artifact-scanner && esbuild apps/artifact-scanner/src/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/apps/artifact-scanner/index.js" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "tsc -p tsconfig.json --noEmit", "cwd": "apps/artifact-scanner" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "vitest run", "cwd": "apps/artifact-scanner" } },
    "container": { "executor": "nx:run-commands", "metadata": { "release": { "image": "opencrane-artifact-scanner", "dockerfile": "apps/artifact-scanner/deploy/Dockerfile" } }, "options": { "command": "docker build -f apps/artifact-scanner/deploy/Dockerfile ." } }
  }
}
