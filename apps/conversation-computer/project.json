{
  "name": "conversation-computer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/conversation-computer/src",
  "tags": ["type:app", "layer:entrypoint", "scope:conversation-computer"],
  "targets": {
    "build": { "executor": "nx:run-commands", "dependsOn": ["backend-conversation-computer-review-surface:build"], "options": { "command": "PYTHONPATH=../../libs/backend/conversation-computer/review-surface/src python3 -B -m py_compile src/*.py", "cwd": "apps/conversation-computer" } },
    "lint": { "executor": "nx:run-commands", "dependsOn": ["backend-conversation-computer-review-surface:lint"], "options": { "command": "PYTHONPATH=../../libs/backend/conversation-computer/review-surface/src python3 -B -m py_compile src/*.py", "cwd": "apps/conversation-computer" } },
    "test": { "executor": "nx:run-commands", "dependsOn": ["backend-conversation-computer-review-surface:test"], "options": { "command": "PYTHONPATH=../../libs/backend/conversation-computer/review-surface/src python3 -B -m unittest discover -s tests", "cwd": "apps/conversation-computer" } },
    "container": {
      "executor": "nx:run-commands",
      "metadata": {
        "release": {
          "image": "opencrane-conversation-computer",
          "dockerfile": "apps/conversation-computer/deploy/Dockerfile"
        }
      },
      "options": { "command": "docker build -f apps/conversation-computer/deploy/Dockerfile ." }
    }
  }
}
