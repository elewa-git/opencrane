{
  "name": "opencrane-prisma-migrator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/opencrane-prisma-migrator",
  "metadata": { "release": { "adaptedVersion": "0.10.0" } },
  "tags": ["type:app", "layer:entrypoint", "scope:opencrane"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "bash apps/opencrane-prisma-migrator/tests/build-contract.sh" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "bash apps/opencrane-prisma-migrator/tests/run-migrations-contract.sh" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bash -n apps/opencrane-prisma-migrator/run-migrations.sh apps/opencrane-prisma-migrator/tests/build-contract.sh apps/opencrane-prisma-migrator/tests/run-migrations-contract.sh" }
    },
    "container": {
      "executor": "nx:run-commands",
      "metadata": {
        "release": {
          "image": "opencrane-prisma-migrator",
          "dockerfile": "apps/opencrane/deploy/Dockerfile",
          "target": "migration"
        }
      },
      "options": { "command": "docker build --target migration -f apps/opencrane/deploy/Dockerfile ." }
    }
  }
}
