/// Identifies whether a persisted grant belongs to a Group or directly to a Principal.
/// Authorization resolves Group subjects through stored direct memberships; changing these mapped
/// values requires a data migration because AuthorizationGrant rows store them.
enum AuthorizationSubjectKind {
  /// The grant applies when the caller has a direct stored membership in the subject Group.
  Group     @map("group")
  /// The grant applies directly to the named person or service Principal.
  Principal @map("principal")
}

/// Identifies the persisted product boundary that a grant protects.
/// Authorization loads Group ancestry from product storage, while Personal boundaries never use
/// hierarchy. Changing these mapped values requires a data migration.
enum AuthorizationBoundaryKind {
  /// The grant protects one stored Group node, subject to its AuthorizationBoundaryCoverage.
  Group    @map("group")
  /// The grant protects resources owned by one Principal and cannot cover descendants.
  Personal @map("personal")
}

/// Controls whether a persisted grant stops at its boundary or follows stored Group descendants.
/// Authorization rejects Descendants on a Personal boundary. Changing these mapped values requires
/// a data migration because callers branch on the stored value.
enum AuthorizationBoundaryCoverage {
  /// The grant covers the named Group or Personal boundary and nothing below it.
  Exact       @map("exact")
  /// The grant covers the named Group and Groups whose stored ancestor path contains it.
  Descendants @map("descendants")
}

enum AuthorizationEffect {
  Allow @map("allow")
  Deny  @map("deny")
}

enum ApprovalRequestState {
  Pending   @map("pending")
  Approved  @map("approved")
  Denied    @map("denied")
  Expired   @map("expired")
  Cancelled @map("cancelled")
}

/// Scope chosen by the original requester for an approved tool invocation.
enum ToolApprovalDecisionScope {
  /// Approves only the reviewed invocation.
  Once   @map("once")
  /// Also creates an exact, revocable standing consent for later matching invocations.
  Always @map("always")
}

/// Lifecycle of an exact requester-owned standing tool consent.
enum ToolApprovalScopeState {
  /// Matching invocations may receive a one-use admission while current execution authority remains valid.
  Active  @map("active")
  /// New admissions are fenced; already claimed effects remain historical facts.
  Revoked @map("revoked")
}

/// Provenance of the one-use approval evidence attached to an invocation.
enum ToolApprovalAdmissionOrigin {
  /// The admission was derived from a requester-owned standing consent.
  StandingConsent @map("standing_consent")
}

/// Durable lifecycle of one externally effectful runtime tool invocation. These states belong to
/// ToolInvocation because provider ambiguity, approval, and recovery belong to the runtime tool
/// path and its transaction-bound authorization admission.
enum ToolInvocationState {
  Preparing        @map("preparing")
  AwaitingApproval @map("awaiting_approval")
  Ready            @map("ready")
  Claimed          @map("claimed")
  Reconciling      @map("reconciling")
  Succeeded        @map("succeeded")
  Failed           @map("failed")
  RecoveryRequired @map("recovery_required")
}

/// Recovery capability frozen from the trusted adapter before any provider dispatch begins.
enum ExternalActionRecoveryMode {
  ProviderIdempotency @map("provider_idempotency")
  Reconciliation      @map("reconciliation")
  Manual              @map("manual")
}

/// Kind of provider work protected by the current monotonic claim fence.
enum ExternalActionClaimKind {
  Dispatch  @map("dispatch")
  Reconcile @map("reconcile")
}

/// Delivery lifecycle for the exact server-owned tool result returned to the runtime loop.
enum ToolResultDeliveryState {
  Pending  @map("pending")
  Consumed @map("consumed")
}

model AuthorizationGrant {
  id                     String                        @id @default(cuid())
  siloId                 String                        @map("silo_id")
  subjectKind            AuthorizationSubjectKind      @map("subject_kind")
  subjectGroupId         String?                       @map("subject_group_id")
  subjectPrincipalId     String?                       @map("subject_principal_id")
  boundaryKind           AuthorizationBoundaryKind     @map("boundary_kind")
  boundaryGroupId        String?                       @map("boundary_group_id")
  boundaryPrincipalId    String?                       @map("boundary_principal_id")
  boundaryCoverage       AuthorizationBoundaryCoverage @map("boundary_coverage")
  /// Names the product editor that owns reconciliation of this row. Null means no editor owns it.
  managerId              String?                       @map("manager_id")
  catalogId              String                        @map("catalog_id")
  catalogRevision        Int                           @map("catalog_revision")
  catalogDigest          String                        @map("catalog_digest")
  capabilityId           String                        @map("capability_id")
  resourceKind           String                        @map("resource_kind")
  resourceId             String                        @map("resource_id")
  effect                 AuthorizationEffect
  priority               Int
  validFrom              DateTime                      @default(now()) @map("valid_from")
  expiresAt              DateTime?                     @map("expires_at")
  revokedAt              DateTime?                     @map("revoked_at")
  createdBy              String                        @map("created_by")
  createdAt              DateTime                      @default(now()) @map("created_at")
  catalog                CapabilityCatalogRevision     @relation(fields: [catalogId, catalogRevision, catalogDigest], references: [catalogId, revision, digest], onDelete: Restrict)
  subjectGroup           Group?                        @relation("AuthorizationGrantSubjectGroup", fields: [subjectGroupId, siloId], references: [id, siloId], onDelete: Restrict)
  subjectPrincipal       Principal?                    @relation("AuthorizationGrantSubjectPrincipal", fields: [subjectPrincipalId, siloId], references: [id, siloId], onDelete: Restrict)
  boundaryGroup          Group?                        @relation("AuthorizationGrantBoundaryGroup", fields: [boundaryGroupId, siloId], references: [id, siloId], onDelete: Restrict)
  boundaryPrincipal      Principal?                    @relation("AuthorizationGrantBoundaryPrincipal", fields: [boundaryPrincipalId, siloId], references: [id, siloId], onDelete: Restrict)
  resourceShareRecipient ResourceShareRecipient?

  @@index([siloId, subjectKind, subjectGroupId, subjectPrincipalId])
  @@index([siloId, boundaryKind, boundaryGroupId, boundaryPrincipalId, boundaryCoverage])
  @@index([siloId, managerId])
  @@index([siloId, resourceKind, resourceId, priority])
  @@index([catalogId, catalogRevision, capabilityId])
  @@map("authorization_grants")
}

model CapabilityCatalogRevision {
  id           String                   @id @default(cuid())
  catalogId    String                   @map("catalog_id")
  revision     Int
  digest       String
  capabilities Json
  createdBy    String                   @map("created_by")
  createdAt    DateTime                 @default(now()) @map("created_at")
  grants       AuthorizationGrant[]

  @@unique([catalogId, revision])
  @@unique([catalogId, digest])
  @@unique([catalogId, revision, digest])
  @@map("capability_catalog_revisions")
}

model ApprovalRequest {
  id                       String                     @id @default(cuid())
  runId                    String                     @map("run_id")
  attempt                  Int
  agentRevisionId          String                     @map("agent_revision_id")
  agentServiceId           String                     @map("agent_service_id")
  siloId                   String                     @map("silo_id")
  agentIdentityId          String                     @map("agent_identity_id")
  principalId              String                     @map("principal_id")
  resourceKind             String                     @map("resource_kind")
  resourceId               String                     @map("resource_id")
  action                   String
  argumentsDigest          String                     @map("arguments_digest")
  actionDigest             String                     @map("action_digest")
  approverPolicyRevision   String                     @map("approver_policy_revision")
  effectivePolicyDigest    String                     @map("effective_policy_digest")
  state                    ApprovalRequestState       @default(Pending)
  expiresAt                DateTime                   @map("expires_at")
  decidedAt                DateTime?                  @map("decided_at")
  decidedBy                String?                    @map("decided_by")
  elicitationRequestId     String                     @unique @map("elicitation_request_id")
  toolInvocationRowId      String                     @map("tool_invocation_row_id")
  reviewedToolArguments    Json                       @map("reviewed_tool_arguments")
  reviewedToolSchema       Json                       @map("reviewed_tool_schema")
  reviewedToolSchemaDigest String                     @map("reviewed_tool_schema_digest")
  safeProposedArguments    Json                       @map("safe_proposed_arguments")
  responseSchema           Json                       @map("response_schema")
  finalArguments           Json?                      @map("final_arguments")
  finalArgumentsDigest     String?                    @map("final_arguments_digest")
  decisionScope            ToolApprovalDecisionScope? @map("decision_scope")
  createdAt                DateTime                   @default(now()) @map("created_at")
  run                      AgentRun                   @relation(fields: [runId, agentServiceId, agentRevisionId], references: [id, agentServiceId, agentRevisionId], onDelete: Restrict)
  toolInvocation           ToolInvocation             @relation(fields: [toolInvocationRowId], references: [id], onDelete: Restrict)
  elicitationRequest       ElicitationRequest         @relation(fields: [elicitationRequestId], references: [id], onDelete: Restrict)
  standingScope            ToolApprovalScope?

  @@unique([runId, attempt, actionDigest])
  @@index([state, expiresAt])
  @@index([agentIdentityId, principalId])
  @@map("approval_requests")
}

/// Exact requester-owned standing consent created from one authenticated human approval.
model ToolApprovalScope {
  id                           String                 @id @default(cuid())
  siloId                       String                 @map("silo_id")
  requesterPrincipalId         String                 @map("requester_principal_id")
  requesterSubjectId           String                 @map("requester_subject_id")
  agentServiceId               String                 @map("agent_service_id")
  agentRevisionId              String                 @map("agent_revision_id")
  connectionId                 String?                @map("connection_id")
  connectionOwnerPrincipalId   String                 @map("connection_owner_principal_id")
  connectionGeneration         Int?                   @map("connection_generation")
  connectionEndpointDigest     String?                @map("connection_endpoint_digest")
  toolRevisionId               String                 @map("tool_revision_id")
  toolAction                   String                 @map("tool_action")
  reviewedArguments            Json                   @map("reviewed_arguments")
  argumentsDigest              String                 @map("arguments_digest")
  routineId                    String?                @map("routine_id")
  routineRevision              Int?                   @map("routine_revision")
  actionLabel                  String                 @map("action_label")
  targetLabel                  String                 @map("target_label")
  externalSystemLabel          String?                @map("external_system_label")
  assistantLabel               String?                @map("assistant_label")
  connectionOwnerLabel         String                 @map("connection_owner_label")
  sourceApprovalRequestId      String                 @unique @map("source_approval_request_id")
  scopeIdentityDigest          String                 @map("scope_identity_digest")
  activeIdentityDigest         String?                @unique @map("active_identity_digest")
  state                        ToolApprovalScopeState @default(Active)
  revision                     Int                    @default(0)
  revocationIdempotencyDigest  String?                @map("revocation_idempotency_digest")
  revocationCommandDigest      String?                @map("revocation_command_digest")
  revokedByPrincipalId         String?                @map("revoked_by_principal_id")
  revokedAt                    DateTime?              @map("revoked_at")
  createdAt                    DateTime               @default(now()) @map("created_at")
  sourceApprovalRequest        ApprovalRequest        @relation(fields: [sourceApprovalRequestId], references: [id], onDelete: Restrict)
  admissions                   ToolApprovalAdmission[]

  @@index([siloId, requesterPrincipalId, state, createdAt])
  @@index([scopeIdentityDigest, state])
  @@index([siloId, agentServiceId, agentRevisionId, toolRevisionId, toolAction, argumentsDigest, state])
  @@map("tool_approval_scopes")
}

/// One-use approval evidence derived from a standing consent for one concrete invocation.
model ToolApprovalAdmission {
  id                 String                      @id @default(cuid())
  scopeId            String                      @map("scope_id")
  scopeRevision      Int                         @map("scope_revision")
  toolInvocationId   String                      @unique @map("tool_invocation_id")
  origin             ToolApprovalAdmissionOrigin @default(StandingConsent)
  argumentsDigest    String                      @map("arguments_digest")
  createdAt          DateTime                    @default(now()) @map("created_at")
  consumedAt         DateTime?                   @map("consumed_at")
  consumedClaimFence Int?                        @map("consumed_claim_fence")
  scope              ToolApprovalScope           @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  toolInvocation     ToolInvocation               @relation(fields: [toolInvocationId], references: [id], onDelete: Restrict)

  @@index([scopeId, scopeRevision, consumedAt])
  @@map("tool_approval_admissions")
}

/// Identifies the only non-task actor class that may own a ToolInvocation.
///
/// A workload acts only through the exact ExecutionSubject admitted for its AgentRun. Caller-owned
/// MCP tasks have no workload actor and leave this nullable column empty.
enum ToolInvocationAuthorizationActorKind {
  Workload @map("workload")
}

model ToolInvocation {
  id                       String                           @id @default(cuid())
  siloId                   String                           @map("silo_id")
  runId                    String?                          @map("run_id")
  attempt                  Int?
  agentServiceId           String?                          @map("agent_service_id")
  agentRevisionId          String?                          @map("agent_revision_id")
  mcpTaskId                String?                          @unique @map("mcp_task_id")
  agentIdentityId          String?                          @map("agent_identity_id")
  principalId              String                           @map("principal_id")
  authorizationActorKind   ToolInvocationAuthorizationActorKind? @map("authorization_actor_kind")
  authorizationExecutionSubject Json?                       @map("authorization_execution_subject")
  authorizationCoordinates Json?                            @map("authorization_coordinates")
  authorizationDecisionDigests String[]                     @default([]) @map("authorization_decision_digests")
  authorizationAssignmentDigest String?                     @map("authorization_assignment_digest")
  authorizationEvidenceDigest String?                       @map("authorization_evidence_digest")
  runtimeInstanceId        String                           @map("runtime_instance_id")
  commandId                String                           @map("command_id")
  candidateId              String                           @map("candidate_id")
  toolRevisionId           String                           @map("tool_revision_id")
  toolInvocationId         String                           @map("tool_invocation_id")
  arguments                Json
  argumentsDigest          String                           @map("arguments_digest")
  effectiveArguments       Json                             @map("effective_arguments")
  effectiveArgumentsDigest String                           @map("effective_arguments_digest")
  requestFingerprint       String                           @unique @map("request_fingerprint")
  requestIdentity          Json                             @map("request_identity")
  approvalRequired         Boolean                          @default(false) @map("approval_required")
  recoveryMode             ExternalActionRecoveryMode       @map("recovery_mode")
  recoveryKey              String?                          @map("recovery_key")
  state                    ToolInvocationState              @default(Preparing)
  preparationAttempt       Int                              @default(0) @map("preparation_attempt")
  retryDeadlineAt          DateTime                         @map("retry_deadline_at")
  nextPreparationAttemptAt DateTime                         @map("next_preparation_attempt_at")
  claimAttempt             Int                              @default(0) @map("claim_attempt")
  claimKind                ExternalActionClaimKind?         @map("claim_kind")
  claimFence               Int                              @default(0) @map("claim_fence")
  claimExpiresAt           DateTime?                        @map("claim_expires_at")
  recoveryRequiredAt       DateTime?                        @map("recovery_required_at")
  result                   Json?
  failureCode              String?                          @map("failure_code")
  revision                 Int                              @default(0)
  createdAt                DateTime                         @default(now()) @map("created_at")
  updatedAt                DateTime                         @updatedAt @map("updated_at")
  completedAt              DateTime?                        @map("completed_at")
  run                      AgentRun?                        @relation(fields: [runId, agentServiceId, agentRevisionId], references: [id, agentServiceId, agentRevisionId], onDelete: Restrict)
  mcpTask                  McpTask?                         @relation(fields: [mcpTaskId], references: [id], onDelete: Restrict)
  approvalRequests         ApprovalRequest[]
  standingApprovalAdmission ToolApprovalAdmission?
  resultDelivery           ToolResultDelivery?
  personalMemoryPermission PersonalMemoryPermissionReceipt?
  mcpRuntimeExecution      McpRuntimeExecution?

  @@unique([runId, attempt, toolInvocationId])
  @@unique([runId, attempt, candidateId])
  @@index([siloId, agentIdentityId, principalId])
  @@index([runId, attempt, state])
  @@index([state, nextPreparationAttemptAt])
  @@index([state, claimExpiresAt])
  @@map("tool_invocations")
}

/// One-to-one outbox intent created in the same transaction that terminalises its invocation.
/// The runtime command authority consumes it only after persisting the exact resume command body.
model ToolResultDelivery {
  id               String                  @id @default(cuid())
  toolInvocationId String                  @unique @map("tool_invocation_id")
  state            ToolResultDeliveryState @default(Pending)
  payload          Json
  payloadDigest    String                  @map("payload_digest")
  createdAt        DateTime                @default(now()) @map("created_at")
  consumedAt       DateTime?               @map("consumed_at")
  invocation       ToolInvocation          @relation(fields: [toolInvocationId], references: [id], onDelete: Restrict)

  @@index([state, createdAt])
  @@map("tool_result_deliveries")
}
