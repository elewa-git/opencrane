enum ChannelInvocationAction {
  EventsRead @map("events.read")
}

/// Exact endpoint evidence for one AgentService channel operation. A route id names the
/// service-specific row; receiverId independently names the stable receiving runtime.
model ChannelRuntimeRoute {
  id                 String                     @id @default(cuid())
  receiverId         String                     @map("receiver_id")
  siloId             String                     @map("silo_id")
  agentServiceId     String                     @map("agent_service_id")
  action             ChannelInvocationAction
  endpoint           String
  isCurrent          Boolean                    @default(true) @map("is_current")
  registeredAt       DateTime                   @default(now()) @map("registered_at")
  legacyExpiresAt    DateTime?                  @map("legacy_expires_at")
  revokedAt          DateTime?                  @map("revoked_at")
  invocationContexts ChannelInvocationContext[]

  @@unique([id, receiverId, siloId, agentServiceId, action], map: "channel_runtime_routes_exact_target_key")
  @@unique([receiverId, siloId, agentServiceId, action], map: "channel_runtime_routes_receiver_service_key")
  @@index([siloId, agentServiceId, action, isCurrent], map: "channel_runtime_routes_current_lookup_idx")
  @@map("channel_runtime_routes")
}

/// Digest-only one-time authorization context. The opaque bearer value is returned once
/// to channel-proxy and is never stored; the runtime PEP consumes it online by digest.
model ChannelInvocationContext {
  id                  String                  @id @default(cuid())
  digest              String                  @unique
  subjectId           String                  @map("subject_id")
  siloId              String                  @map("silo_id")
  conversationId      String                  @map("conversation_id")
  agentServiceId      String                  @map("agent_service_id")
  action              ChannelInvocationAction
  routeId             String                  @map("route_id")
  receiverId          String                  @map("receiver_id")
  membershipRevision  Int                     @map("membership_revision")
  authorizationDigest String                  @map("authorization_digest")
  expiresAt           DateTime                @map("expires_at")
  consumedAt          DateTime?               @map("consumed_at")
  revokedAt           DateTime?               @map("revoked_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  route               ChannelRuntimeRoute     @relation(fields: [routeId, receiverId, siloId, agentServiceId, action], references: [id, receiverId, siloId, agentServiceId, action], onDelete: Restrict)

  @@index([digest, expiresAt], map: "channel_invocation_contexts_digest_expiry_idx")
  @@index([routeId, expiresAt], map: "channel_invocation_contexts_route_expiry_idx")
  @@index([subjectId, siloId, conversationId, createdAt], map: "channel_invocation_contexts_subject_conversation_idx")
  @@map("channel_invocation_contexts")
}
