enum ConversationAssetProvenance {
  ParticipantUpload @map("participant_upload")
}

enum ConversationAssetState {
  Uploading  @map("uploading")
  Processing @map("processing")
  Ready      @map("ready")
  Failed     @map("failed")
  Removed    @map("removed")
}

/// Browser-safe conversation linkage to one upload or immutable checked revision.
model ConversationAsset {
  id                    String                         @id @default(cuid())
  siloId                String                         @map("silo_id")
  conversationId        String                         @map("conversation_id")
  messageId             String?                        @map("message_id")
  artifactId            String?                        @map("artifact_id")
  revisionId            String?                        @map("revision_id")
  uploadLeaseId         String?                        @unique @map("upload_lease_id")
  idempotencyKey        String                         @map("idempotency_key")
  provenance            ConversationAssetProvenance
  state                 ConversationAssetState
  displayName           String                         @map("display_name")
  mediaType             String                         @map("media_type")
  byteLength            BigInt?                        @map("byte_length")
  failureCode           String?                        @map("failure_code")
  createdByUserId       String?                        @map("created_by_user_id")
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")
  removedAt             DateTime?                      @map("removed_at")
  conversation          Conversation                   @relation(fields: [conversationId, siloId], references: [id, siloId], onDelete: Restrict)
  message               ConversationMessage?           @relation(fields: [conversationId, messageId], references: [conversationId, id], onDelete: Restrict)
  artifact              Artifact?                      @relation(fields: [artifactId, siloId], references: [id, siloId], onDelete: Restrict)
  revision              ArtifactRevision?              @relation(fields: [artifactId, revisionId], references: [artifactId, id], onDelete: Restrict)
  uploadLease           ArtifactUploadLease?           @relation(fields: [uploadLeaseId], references: [id], onDelete: Restrict)

  @@unique([conversationId, id])
  @@unique([conversationId, createdByUserId, idempotencyKey], map: "conversation_assets_participant_idempotency_key")
  @@index([conversationId, state, createdAt])
  @@index([messageId])
  @@index([artifactId, revisionId])
  @@map("conversation_assets")
}
