enum ConversationAssetProvenance {
  ParticipantUpload @map("participant_upload")
  AgentOutput       @map("agent_output")
}

enum ConversationAssetState {
  Uploading  @map("uploading")
  Processing @map("processing")
  Ready      @map("ready")
  Failed     @map("failed")
  Removed    @map("removed")
}

/// Browser-safe conversation linkage to one upload or immutable checked revision.
model ConversationAsset {
  id                    String                         @id @default(cuid())
  siloId                String                         @map("silo_id")
  conversationId        String                         @map("conversation_id")
  messageId             String?                        @map("message_id")
  runId                 String?                        @map("run_id")
  runAttempt            Int?                           @map("run_attempt")
  runEventSequence      Int?                           @map("run_event_sequence")
  runMessageId          String?                        @map("run_message_id")
  artifactId            String?                        @map("artifact_id")
  revisionId            String?                        @map("revision_id")
  uploadLeaseId         String?                        @unique @map("upload_lease_id")
  outputTicketId        String?                        @unique @map("output_ticket_id")
  idempotencyKey        String                         @map("idempotency_key")
  provenance            ConversationAssetProvenance
  state                 ConversationAssetState
  displayName           String                         @map("display_name")
  mediaType             String                         @map("media_type")
  byteLength            BigInt?                        @map("byte_length")
  failureCode           String?                        @map("failure_code")
  createdByUserId       String?                        @map("created_by_user_id")
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")
  removedAt             DateTime?                      @map("removed_at")
  conversation          Conversation                   @relation(fields: [conversationId, siloId], references: [id, siloId], onDelete: Restrict)
  message               ConversationMessage?           @relation(fields: [conversationId, messageId], references: [conversationId, id], onDelete: Restrict)
  run                   AgentRun?                      @relation(fields: [conversationId, runId], references: [conversationId, id], onDelete: Restrict)
  runEvent              ConversationRunEvent?          @relation(fields: [conversationId, runId, runEventSequence], references: [conversationId, runId, sequence], onDelete: Restrict)
  artifact              Artifact?                      @relation(fields: [artifactId, siloId], references: [id, siloId], onDelete: Restrict)
  revision              ArtifactRevision?              @relation(fields: [artifactId, revisionId], references: [artifactId, id], onDelete: Restrict)
  uploadLease           ArtifactUploadLease?           @relation(fields: [uploadLeaseId], references: [id], onDelete: Restrict)
  outputTicket          ConversationAssetOutputTicket? @relation(fields: [outputTicketId, siloId, conversationId, runId, runAttempt, runEventSequence, runMessageId], references: [id, siloId, conversationId, runId, runAttempt, runEventSequence, outputMessageId], onDelete: Restrict, map: "conversation_assets_exact_output_ticket_fkey")
  agentThreadDeliveries AgentThreadParentDelivery[]

  @@unique([conversationId, id])
  @@unique([outputTicketId, siloId, conversationId, runId, runAttempt, runEventSequence, runMessageId], map: "conversation_assets_exact_output_ticket_key")
  @@unique([conversationId, createdByUserId, idempotencyKey], map: "conversation_assets_participant_idempotency_key")
  @@index([conversationId, state, createdAt])
  @@index([messageId])
  @@index([runId, runAttempt])
  @@index([artifactId, revisionId])
  @@map("conversation_assets")
}

/// One retry-stable authority to publish exactly one generated conversation asset.
model ConversationAssetOutputTicket {
  id                      String               @id @default(cuid())
  siloId                  String               @map("silo_id")
  conversationId          String               @map("conversation_id")
  runId                   String               @map("run_id")
  runAttempt              Int                  @map("run_attempt")
  runEventSequence        Int                  @map("run_event_sequence")
  outputMessageId         String               @map("output_message_id")
  idempotencyKey          String               @map("idempotency_key")
  finalizedContentAddress String?              @map("finalized_content_address")
  finalizedReceiptDigest  String?              @unique @map("finalized_receipt_digest")
  finalizedAt             DateTime?            @map("finalized_at")
  expiresAt               DateTime             @map("expires_at")
  createdAt               DateTime             @default(now()) @map("created_at")
  conversation            Conversation         @relation(fields: [conversationId, siloId], references: [id, siloId], onDelete: Restrict)
  run                     AgentRun             @relation(fields: [conversationId, runId], references: [conversationId, id], onDelete: Restrict)
  assignment              WorkloadAssignment   @relation(fields: [runId, runAttempt], references: [runId, attempt], onDelete: Restrict)
  runEvent                ConversationRunEvent @relation(fields: [conversationId, runId, runEventSequence], references: [conversationId, runId, sequence], onDelete: Restrict)
  asset                   ConversationAsset?

  @@unique([runId, runAttempt, idempotencyKey])
  @@unique([id, siloId, conversationId, runId, runAttempt, runEventSequence, outputMessageId], map: "conversation_asset_output_tickets_exact_asset_key")
  @@index([conversationId, createdAt])
  @@map("conversation_asset_output_tickets")
}
