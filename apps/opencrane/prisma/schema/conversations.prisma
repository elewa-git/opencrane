enum ConversationMode {
  AgentSession @map("agent_session")
  Direct       @map("direct")
  Group        @map("group")
}

enum ConversationLifecycle {
  Open   @map("open")
  Closed @map("closed")
}

enum ConversationMessageRole {
  User      @map("user")
  Assistant @map("assistant")
  Tool      @map("tool")
  System    @map("system")
}

enum ConversationMessageState {
  Pending   @map("pending")
  Streaming @map("streaming")
  Completed @map("completed")
  Failed    @map("failed")
  Cancelled @map("cancelled")
}

enum ConversationTimelineEntryKind {
  Message        @map("message")
  RunEvent       @map("run_event")
  Membership     @map("membership")
  System         @map("system")
}

model Conversation {
  id                            String                          @id @default(cuid())
  siloId                        String                          @map("silo_id")
  mode                          ConversationMode
  agentServiceId                String?                         @map("agent_service_id")
  /// Rebuildable pointer to the logical computer stream for an agent session.
  computerId                    String?                         @map("computer_id")
  /// Rebuildable identity coordinate required to validate the computer stream.
  computerAgentIdentityId       String?                         @map("computer_agent_identity_id")
  /// Rebuildable profile coordinate required to validate the computer stream.
  computerProfileRevisionId     String?                         @map("computer_profile_revision_id")
  lifecycle                     ConversationLifecycle           @default(Open)
  contextRevisionId             String?                         @map("context_revision_id")
  closedAt                      DateTime?                       @map("closed_at")
  createdAt                     DateTime                        @default(now()) @map("created_at")
  /// Real database append time for display. Lifecycle or context updates do not advance it.
  updatedAt                     DateTime                        @default(now()) @map("updated_at")
  /// Global database allocation order for list sorting. Rollbacks may leave gaps; commit order does not rewrite it.
  activitySequence              BigInt                          @unique @default(autoincrement()) @map("activity_sequence")
  participants                  ConversationParticipant[]
  privatePayloads               ConversationPrivatePayload[]
  messages                      ConversationMessage[]
  runEvents                     ConversationRunEvent[]
  timelineEntries               ConversationTimelineEntry[]
  contextRevisions              ConversationContextRevision[]   @relation("ConversationContextRevisions")
  runs                          AgentRun[]
  elicitationRequests           ElicitationRequest[]
  activeContext                 ConversationContextRevision?    @relation("ActiveConversationContext", fields: [id, contextRevisionId], references: [conversationId, id], onDelete: Restrict)
  assets                        ConversationAsset[]
  activeComputerLease           ConversationComputerActiveLease?
  service                       AgentService?                   @relation(fields: [agentServiceId, siloId], references: [id, siloId], onDelete: Restrict)

  @@unique([id, siloId])
  @@unique([id, siloId, agentServiceId], map: "conversations_exact_service_key")
  @@unique([id, contextRevisionId])
  @@index([siloId, mode, lifecycle, activitySequence])
  @@index([siloId, agentServiceId, lifecycle])
  @@map("conversations")
}

/// Rebuildable projection of the one active Agent Sandbox lease for a conversation computer.
///
/// Row existence means active. Immutable computer history remains authoritative and can rebuild or
/// delete this projection after crashes; callers must not interpret an expired row as authority.
model ConversationComputerActiveLease {
  computerId       String       @id @map("computer_id")
  siloId           String       @map("silo_id")
  conversationId   String       @unique @map("conversation_id")
  agentIdentityId  String       @map("agent_identity_id")
  leaseId          String       @unique @map("lease_id")
  leaseGeneration  Int          @map("lease_generation")
  expiresAt        DateTime     @map("expires_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  conversation     Conversation @relation(fields: [conversationId, siloId], references: [id, siloId], onDelete: Restrict)

  @@unique([conversationId, siloId])
  @@unique([computerId, leaseGeneration])
  @@index([siloId, agentIdentityId])
  @@index([expiresAt])
  @@map("conversation_computer_active_leases")
}

/// Stores encrypted participant-visible payload bytes outside immutable KurrentDB history.
model ConversationPrivatePayload {
  /// Opaque reference recorded in the conversation entry.
  id             String       @id
  /// Organisation boundary copied from the trusted conversation projection.
  siloId         String       @map("silo_id")
  /// Conversation whose authorised participants may decrypt this payload.
  conversationId String       @map("conversation_id")
  /// Participant that submitted the plaintext before server-side encryption.
  authorSubject  String       @map("author_subject")
  /// Browser retry key shared with the immutable KurrentDB entry.
  idempotencyKey String       @map("idempotency_key")
  /// Keyring identifier required to decrypt this ciphertext.
  keyId          String       @map("key_id")
  /// AES-GCM nonce generated independently for this payload.
  nonce          Bytes
  /// AES-GCM authentication tag checked before plaintext is returned.
  authTag        Bytes        @map("auth_tag")
  /// AES-GCM ciphertext; plaintext is never persisted.
  ciphertext     Bytes
  /// SHA-256 digest of the exact ciphertext recorded in KurrentDB.
  ciphertextDigest String     @map("ciphertext_digest")
  /// Creation timestamp retained for encrypted-payload operations.
  createdAt      DateTime     @default(now()) @map("created_at")
  /// Exact parent projection prevents a payload from crossing conversations.
  conversation   Conversation @relation(fields: [conversationId, siloId], references: [id, siloId], onDelete: Restrict)

  @@unique([conversationId, authorSubject, idempotencyKey])
  @@index([siloId, conversationId])
  @@map("conversation_private_payloads")
}

/// Holds an encrypted, short-lived LiteLLM attempt key for bootstrap response-loss recovery.
model ConversationComputerAttemptCredential {
  bootstrapId      String   @id @map("bootstrap_id")
  keyAlias         String   @map("key_alias")
  modelAlias       String   @map("model_alias")
  siloId           String   @map("silo_id")
  conversationId   String   @map("conversation_id")
  state             String   @default("pending")
  claimFence        String   @map("claim_fence")
  claimExpiresAt    DateTime @map("claim_expires_at")
  keyId             String?  @map("key_id")
  nonce             Bytes?
  authTag            Bytes?  @map("auth_tag")
  ciphertext         Bytes?
  ciphertextDigest   String? @map("ciphertext_digest")
  credentialDigest  String? @map("credential_digest")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("conversation_computer_attempt_credentials")
}

model ConversationParticipant {
  conversationId        String                      @map("conversation_id")
  userId                String                      @map("user_id")
  visibleFromPosition   BigInt                      @default(0) @map("visible_from_position")
  readThroughPosition   BigInt                      @default(0) @map("read_through_position")
  accessEndedPosition   BigInt?                     @map("access_ended_position")
  archivedAt            DateTime?                   @map("archived_at")
  joinedAt              DateTime                    @default(now()) @map("joined_at")
  conversation          Conversation                @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  timelineEntries       ConversationTimelineEntry[]
  assignedElicitations  ElicitationRequest[]

  @@id([conversationId, userId])
  @@index([userId, archivedAt, conversationId])
  @@map("conversation_participants")
}

model ConversationMessage {
  id                 String                     @id @default(cuid())
  conversationId     String                     @map("conversation_id")
  runId              String?                    @map("run_id")
  userId             String?                    @map("user_id")
  idempotencyKey     String                     @map("idempotency_key")
  role               ConversationMessageRole
  state              ConversationMessageState
  source             String
  blocks             Json
  createdAt          DateTime                   @default(now()) @map("created_at")
  completedAt        DateTime?                  @map("completed_at")
  conversation       Conversation               @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  timelineEntry      ConversationTimelineEntry?
  assets             ConversationAsset[]

  @@unique([conversationId, id])
  @@unique([conversationId, idempotencyKey])
  @@index([runId])
  @@map("conversation_messages")
}

model ConversationRunEvent {
  conversationId     String                          @map("conversation_id")
  runId              String                          @map("run_id")
  attempt            Int
  sequence           Int
  type               String
  messageId          String?                         @map("message_id")
  payload            Json
  occurredAt         DateTime                        @default(now()) @map("occurred_at")
  conversation       Conversation                    @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  timelineEntry      ConversationTimelineEntry?

  @@id([runId, sequence])
  @@unique([conversationId, runId, sequence])
  @@unique([conversationId, runId, attempt, sequence])
  @@index([runId, attempt, messageId])
  @@index([runId, occurredAt])
  @@map("conversation_run_events")
}

model ConversationTimelineEntry {
  conversationId              String                        @map("conversation_id")
  position                    BigInt                        @default(0)
  kind                        ConversationTimelineEntryKind
  messageId                   String?                       @map("message_id")
  runId                       String?                       @map("run_id")
  runEventSequence            Int?                          @map("run_event_sequence")
  membershipEventId           String?                       @map("membership_event_id")
  participantUserId           String?                       @map("participant_user_id")
  systemEventId               String?                       @map("system_event_id")
  payload                     Json?
  occurredAt                  DateTime                      @default(now()) @map("occurred_at")
  conversation                Conversation                  @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message                     ConversationMessage?          @relation(fields: [conversationId, messageId], references: [conversationId, id], onDelete: Restrict)
  runEvent                    ConversationRunEvent?         @relation(fields: [conversationId, runId, runEventSequence], references: [conversationId, runId, sequence], onDelete: Restrict)
  participant                 ConversationParticipant?      @relation(fields: [conversationId, participantUserId], references: [conversationId, userId], onDelete: Restrict)

  @@id([conversationId, position])
  @@unique([conversationId, messageId])
  @@unique([conversationId, runId, runEventSequence])
  @@unique([conversationId, membershipEventId])
  @@unique([conversationId, systemEventId])
  @@index([conversationId, occurredAt])
  @@map("conversation_timeline_entries")
}

model ConversationContextRevision {
  id               String         @id @default(cuid())
  conversationId   String         @map("conversation_id")
  revision         Int
  throughMessageId String         @map("through_message_id")
  summary          Json
  digest           String
  createdByRunId   String         @map("created_by_run_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  conversation     Conversation   @relation("ConversationContextRevisions", fields: [conversationId], references: [id], onDelete: Restrict)
  activeFor        Conversation[] @relation("ActiveConversationContext")

  @@unique([conversationId, revision])
  @@unique([conversationId, id])
  @@index([createdByRunId])
  @@map("conversation_context_revisions")
}
