enum ConversationMode {
  AgentSession @map("agent_session")
  Direct       @map("direct")
  Group        @map("group")
}

enum ConversationLifecycle {
  Open   @map("open")
  Closed @map("closed")
}

enum ConversationMessageRole {
  User      @map("user")
  Assistant @map("assistant")
  Tool      @map("tool")
  System    @map("system")
}

enum ConversationMessageState {
  Pending   @map("pending")
  Streaming @map("streaming")
  Completed @map("completed")
  Failed    @map("failed")
  Cancelled @map("cancelled")
}

enum ConversationTimelineEntryKind {
  Message        @map("message")
  RunEvent       @map("run_event")
  Membership     @map("membership")
  System         @map("system")
  ParentDelivery @map("parent_delivery")
}

enum AgentThreadDeliveryKind {
  Status   @map("status")
  Question @map("question")
  Approval @map("approval")
  Result   @map("result")
  Failure  @map("failure")
  Asset    @map("asset")
}

model Conversation {
  id                   String                        @id @default(cuid())
  siloId               String                        @map("silo_id")
  mode                 ConversationMode
  agentServiceId       String?                       @map("agent_service_id")
  lifecycle            ConversationLifecycle         @default(Open)
  contextRevisionId    String?                       @map("context_revision_id")
  closedAt             DateTime?                     @map("closed_at")
  createdAt            DateTime                      @default(now()) @map("created_at")
  /// Real database append time for display. Lifecycle or context updates do not advance it.
  updatedAt            DateTime                      @default(now()) @map("updated_at")
  /// Global database allocation order for list sorting. Rollbacks may leave gaps; commit order does not rewrite it.
  activitySequence     BigInt                        @default(autoincrement()) @unique @map("activity_sequence")
  participants         ConversationParticipant[]
  messages             ConversationMessage[]
  runEvents            ConversationRunEvent[]
  timelineEntries      ConversationTimelineEntry[]
  contextRevisions     ConversationContextRevision[] @relation("ConversationContextRevisions")
  runs                 AgentRun[]
  elicitationRequests  ElicitationRequest[]
  activeContext        ConversationContextRevision?  @relation("ActiveConversationContext", fields: [id, contextRevisionId], references: [conversationId, id], onDelete: Restrict)
  assets               ConversationAsset[]
  assetOutputTickets   ConversationAssetOutputTicket[]
  originAgentThread             ConversationAgentThread?        @relation("AgentThreadChild")
  childAgentThreads             ConversationAgentThread[]       @relation("AgentThreadParent")
  rootedAgentThreads            ConversationAgentThread[]       @relation("AgentThreadRoot")
  receivedAgentThreadDeliveries AgentThreadParentDelivery[]     @relation("AgentThreadDeliveryParent")
  sentAgentThreadDeliveries     AgentThreadParentDelivery[]     @relation("AgentThreadDeliveryChild")
  service              AgentService?                 @relation(fields: [agentServiceId, siloId], references: [id, siloId], onDelete: Restrict)

  @@unique([id, siloId])
  @@unique([id, siloId, agentServiceId], map: "conversations_exact_service_key")
  @@unique([id, contextRevisionId])
  @@index([siloId, mode, lifecycle, activitySequence])
  @@index([siloId, agentServiceId, lifecycle])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId      String       @map("conversation_id")
  userId              String       @map("user_id")
  visibleFromPosition BigInt       @default(0) @map("visible_from_position")
  readThroughPosition BigInt       @default(0) @map("read_through_position")
  accessEndedPosition BigInt?      @map("access_ended_position")
  archivedAt          DateTime?    @map("archived_at")
  joinedAt            DateTime     @default(now()) @map("joined_at")
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  timelineEntries     ConversationTimelineEntry[]
  assignedElicitations ElicitationRequest[]
  initiatedAgentThreads ConversationAgentThread[]

  @@id([conversationId, userId])
  @@index([userId, archivedAt, conversationId])
  @@map("conversation_participants")
}

model ConversationMessage {
  id             String                     @id @default(cuid())
  conversationId String                     @map("conversation_id")
  runId          String?                    @map("run_id")
  userId         String?                    @map("user_id")
  idempotencyKey String                     @map("idempotency_key")
  role           ConversationMessageRole
  state          ConversationMessageState
  source         String
  blocks         Json
  createdAt      DateTime                   @default(now()) @map("created_at")
  completedAt    DateTime?                  @map("completed_at")
  conversation   Conversation               @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  timelineEntry  ConversationTimelineEntry?
  assets         ConversationAsset[]
  invokedAgentThread ConversationAgentThread?   @relation("AgentThreadParentMessage")

  @@unique([conversationId, id])
  @@unique([conversationId, idempotencyKey])
  @@index([runId])
  @@map("conversation_messages")
}

model ConversationRunEvent {
  conversationId String                     @map("conversation_id")
  runId           String                     @map("run_id")
  sequence        Int
  type            String
  messageId       String?                    @map("message_id")
  payload         Json
  occurredAt      DateTime                   @default(now()) @map("occurred_at")
  conversation    Conversation               @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  timelineEntry   ConversationTimelineEntry?
  assets          ConversationAsset[]
  assetOutputTickets ConversationAssetOutputTicket[]

  @@id([runId, sequence])
  @@unique([conversationId, runId, sequence])
  @@index([runId, messageId])
  @@index([runId, occurredAt])
  @@map("conversation_run_events")
}

model ConversationTimelineEntry {
  conversationId          String                       @map("conversation_id")
  position                BigInt                       @default(0)
  kind                    ConversationTimelineEntryKind
  messageId               String?                      @map("message_id")
  runId                   String?                      @map("run_id")
  runEventSequence        Int?                         @map("run_event_sequence")
  membershipEventId       String?                      @map("membership_event_id")
  participantUserId       String?                      @map("participant_user_id")
  systemEventId           String?                      @map("system_event_id")
  parentDeliveryChildRunId String?                      @map("parent_delivery_child_run_id")
  parentDeliveryAgentThreadId String?                       @map("parent_delivery_agent_thread_id")
  payload                 Json?
  occurredAt              DateTime                     @default(now()) @map("occurred_at")
  conversation            Conversation                 @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message                 ConversationMessage?         @relation(fields: [conversationId, messageId], references: [conversationId, id], onDelete: Restrict)
  runEvent                ConversationRunEvent?        @relation(fields: [conversationId, runId, runEventSequence], references: [conversationId, runId, sequence], onDelete: Restrict)
  participant             ConversationParticipant?     @relation(fields: [conversationId, participantUserId], references: [conversationId, userId], onDelete: Restrict)
  parentDelivery          ChildRunCompletionDelivery?  @relation(fields: [parentDeliveryChildRunId], references: [childRunId], onDelete: Restrict)
  agentThreadDelivery         AgentThreadParentDelivery?    @relation(fields: [parentDeliveryAgentThreadId], references: [id], onDelete: Restrict)

  @@id([conversationId, position])
  @@unique([conversationId, messageId])
  @@unique([conversationId, runId, runEventSequence])
  @@unique([conversationId, membershipEventId])
  @@unique([conversationId, systemEventId])
  @@unique([parentDeliveryChildRunId])
  @@unique([parentDeliveryAgentThreadId])
  @@index([conversationId, occurredAt])
  @@map("conversation_timeline_entries")
}

/// Immutable link from one ordinary group message to one child agent-session conversation.
model ConversationAgentThread {
  childConversationId  String                      @id @map("child_conversation_id")
  parentConversationId String                      @map("parent_conversation_id")
  rootConversationId   String                      @map("root_conversation_id")
  siloId               String                      @map("silo_id")
  parentMessageId      String                      @map("parent_message_id")
  initiatorUserId      String                      @map("initiator_user_id")
  agentServiceId       String                      @map("agent_service_id")
  personaProfileId     String                      @map("persona_profile_id")
  personaRevisionId    String                      @map("persona_revision_id")
  firstRunId           String                      @unique @map("first_run_id")
  createdAt            DateTime                    @default(now()) @map("created_at")
  childConversation    Conversation                @relation("AgentThreadChild", fields: [childConversationId, siloId, agentServiceId], references: [id, siloId, agentServiceId], onDelete: Restrict)
  parentConversation   Conversation                @relation("AgentThreadParent", fields: [parentConversationId, siloId], references: [id, siloId], onDelete: Restrict)
  rootConversation     Conversation                @relation("AgentThreadRoot", fields: [rootConversationId, siloId], references: [id, siloId], onDelete: Restrict)
  parentMessage        ConversationMessage         @relation("AgentThreadParentMessage", fields: [parentConversationId, parentMessageId], references: [conversationId, id], onDelete: Restrict)
  initiator            ConversationParticipant     @relation(fields: [parentConversationId, initiatorUserId], references: [conversationId, userId], onDelete: Restrict)
  firstRun             AgentRun                    @relation(fields: [firstRunId, childConversationId, siloId, agentServiceId], references: [id, conversationId, siloId, agentServiceId], onDelete: Restrict)
  personaProfile       PersonaProfile              @relation(fields: [personaProfileId, initiatorUserId], references: [id, userId], onDelete: Restrict)
  personaRevision      PersonaRevision             @relation(fields: [personaProfileId, personaRevisionId], references: [personaProfileId, id], onDelete: Restrict)
  deliveries           AgentThreadParentDelivery[]

  @@unique([parentConversationId, parentMessageId])
  @@unique([childConversationId, siloId, agentServiceId], map: "conversation_agent_threads_child_authority_key")
  @@unique([firstRunId, childConversationId, siloId, agentServiceId], map: "conversation_agent_threads_first_run_authority_key")
  @@unique([childConversationId, parentConversationId], map: "conversation_agent_threads_child_parent_key")
  @@index([rootConversationId, createdAt])
  @@index([initiatorUserId, createdAt])
  @@map("conversation_agent_threads")
}

/// Append-only display-safe delivery from one child Agent thread to its immediate parent.
model AgentThreadParentDelivery {
  id                   String                     @id @default(cuid())
  childConversationId  String                     @map("child_conversation_id")
  parentConversationId String                     @map("parent_conversation_id")
  siloId               String                     @map("silo_id")
  agentServiceId       String                     @map("agent_service_id")
  runId                String                     @map("run_id")
  kind                 AgentThreadDeliveryKind
  idempotencyKey       String                     @map("idempotency_key")
  label                String
  detail               String
  assetId              String?                    @map("asset_id")
  createdAt            DateTime                   @default(now()) @map("created_at")
  thread               ConversationAgentThread    @relation(fields: [childConversationId, parentConversationId], references: [childConversationId, parentConversationId], onDelete: Restrict, map: "agent_thread_deliveries_thread_fkey")
  childConversation    Conversation               @relation("AgentThreadDeliveryChild", fields: [childConversationId, siloId, agentServiceId], references: [id, siloId, agentServiceId], onDelete: Restrict, map: "agent_thread_deliveries_child_fkey")
  parentConversation   Conversation               @relation("AgentThreadDeliveryParent", fields: [parentConversationId, siloId], references: [id, siloId], onDelete: Restrict)
  run                  AgentRun                   @relation(fields: [runId, childConversationId, siloId, agentServiceId], references: [id, conversationId, siloId, agentServiceId], onDelete: Restrict)
  asset                ConversationAsset?         @relation(fields: [parentConversationId, assetId], references: [conversationId, id], onDelete: Restrict)
  timelineEntry        ConversationTimelineEntry?

  @@unique([childConversationId, idempotencyKey])
  @@index([parentConversationId, createdAt])
  @@index([runId, createdAt])
  @@map("agent_thread_parent_deliveries")
}

model ConversationContextRevision {
  id               String         @id @default(cuid())
  conversationId   String         @map("conversation_id")
  revision         Int
  throughMessageId String         @map("through_message_id")
  summary          Json
  digest           String
  createdByRunId   String         @map("created_by_run_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  conversation     Conversation   @relation("ConversationContextRevisions", fields: [conversationId], references: [id], onDelete: Restrict)
  activeFor        Conversation[] @relation("ActiveConversationContext")

  @@unique([conversationId, revision])
  @@unique([conversationId, id])
  @@index([createdByRunId])
  @@map("conversation_context_revisions")
}
