enum ConversationMode {
  AgentSession @map("agent_session")
  Direct       @map("direct")
  Group        @map("group")
}

enum ConversationLifecycle {
  Open   @map("open")
  Closed @map("closed")
}

model Conversation {
  id                            String                          @id @default(cuid())
  siloId                        String                          @map("silo_id")
  mode                          ConversationMode
  agentServiceId                String?                         @map("agent_service_id")
  /// Rebuildable pointer to the logical computer stream for an agent session.
  computerId                    String?                         @map("computer_id")
  /// Rebuildable identity coordinate required to validate the computer stream.
  computerAgentIdentityId       String?                         @map("computer_agent_identity_id")
  /// Rebuildable profile coordinate required to validate the computer stream.
  computerProfileRevisionId     String?                         @map("computer_profile_revision_id")
  lifecycle                     ConversationLifecycle           @default(Open)
  closedAt                      DateTime?                       @map("closed_at")
  createdAt                     DateTime                        @default(now()) @map("created_at")
  /// Real database time of the latest participant-visible append; conversation lists sort by it.
  /// The database stamps it inside the transaction that stores a new private payload, and rejects
  /// any other move except a lifecycle change.
  updatedAt                     DateTime                        @default(now()) @map("updated_at")
  participants                  ConversationParticipant[]
  privatePayloads               ConversationPrivatePayload[]
  runs                          AgentRun[]
  elicitationRequests           ElicitationRequest[]
  assets                        ConversationAsset[]
  activeComputerLease           ConversationComputerActiveLease?
  childRequests                 ConversationChildRequest[]
  service                       AgentService?                   @relation(fields: [agentServiceId, siloId], references: [id, siloId], onDelete: Restrict)

  @@unique([id, siloId])
  @@unique([id, siloId, agentServiceId], map: "conversations_exact_service_key")
  /// One computer stream resolves exactly one conversation inside a silo, so a duplicate projection row can never answer for another conversation.
  @@unique([siloId, computerId])
  @@index([siloId, mode, lifecycle, updatedAt])
  @@index([siloId, agentServiceId, lifecycle])
  @@map("conversations")
}

/// Records whether an admitted group request still needs its child conversation or has finished.
enum ConversationChildRequestState {
  Pending     @map("pending")
  Ready       @map("ready")
  Unavailable @map("unavailable")
}

/// Keeps the accepted group command while a workflow creates its KurrentDB history and computer.
/// The request stores identity and audience coordinates; encrypted messages stay in their own store.
model ConversationChildRequest {
  id                       String                        @id
  siloId                   String                        @map("silo_id")
  idempotencyKey           String                        @map("idempotency_key")
  parentConversationId     String                        @map("parent_conversation_id")
  parentMessageId          String                        @map("parent_message_id")
  parentMessagePosition    BigInt                        @map("parent_message_position")
  childConversationId      String                        @unique @map("child_conversation_id")
  computerId               String                        @unique @map("computer_id")
  requestedByPrincipalId   String                        @map("requested_by_principal_id")
  requesterSubjectId       String                        @map("requester_subject_id")
  requesterIssuer          String                        @map("requester_issuer")
  requesterAuthenticatedAt DateTime                      @map("requester_authenticated_at")
  agentServiceId           String                        @map("agent_service_id")
  agentRevisionId          String                        @map("agent_revision_id")
  agentIdentityId          String                        @map("agent_identity_id")
  agentPrincipalId         String                        @map("agent_principal_id")
  agentName                String                        @map("agent_name")
  profileRevisionId        String                        @map("profile_revision_id")
  participantSubjectIds    Json                          @map("participant_subject_ids")
  commandDigest            String                        @map("command_digest")
  state                    ConversationChildRequestState @default(Pending)
  createdAt                DateTime                      @default(now()) @map("created_at")
  parent                   Conversation                  @relation(fields: [parentConversationId, siloId], references: [id, siloId], onDelete: Restrict)

  @@unique([siloId, requestedByPrincipalId, idempotencyKey])
  @@index([parentConversationId, state])
  @@map("conversation_child_requests")
}

/// Rebuildable projection of the one active Agent Sandbox lease for a conversation computer.
///
/// Row existence means active. Immutable computer history remains authoritative and can rebuild or
/// delete this projection after crashes; callers must not interpret an expired row as authority.
model ConversationComputerActiveLease {
  computerId       String       @id @map("computer_id")
  siloId           String       @map("silo_id")
  conversationId   String       @unique @map("conversation_id")
  agentIdentityId  String       @map("agent_identity_id")
  leaseId          String       @unique @map("lease_id")
  leaseGeneration  Int          @map("lease_generation")
  expiresAt        DateTime     @map("expires_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  conversation     Conversation @relation(fields: [conversationId, siloId], references: [id, siloId], onDelete: Restrict)

  @@unique([conversationId, siloId])
  @@unique([computerId, leaseGeneration])
  @@index([siloId, agentIdentityId])
  @@index([expiresAt])
  @@map("conversation_computer_active_leases")
}

/// Stores encrypted participant-visible payload bytes outside immutable KurrentDB history.
model ConversationPrivatePayload {
  /// Opaque reference recorded in the conversation entry.
  id             String       @id
  /// Organisation boundary copied from the trusted conversation projection.
  siloId         String       @map("silo_id")
  /// Conversation whose authorised participants may decrypt this payload.
  conversationId String       @map("conversation_id")
  /// Participant that submitted the plaintext before server-side encryption.
  authorSubject  String       @map("author_subject")
  /// Browser retry key shared with the immutable KurrentDB entry.
  idempotencyKey String       @map("idempotency_key")
  /// Keyring identifier required to decrypt this ciphertext.
  keyId          String       @map("key_id")
  /// AES-GCM nonce generated independently for this payload.
  nonce          Bytes
  /// AES-GCM authentication tag checked before plaintext is returned.
  authTag        Bytes        @map("auth_tag")
  /// AES-GCM ciphertext; plaintext is never persisted.
  ciphertext     Bytes
  /// SHA-256 digest of the exact ciphertext recorded in KurrentDB.
  ciphertextDigest String     @map("ciphertext_digest")
  /// Creation timestamp retained for encrypted-payload operations.
  createdAt      DateTime     @default(now()) @map("created_at")
  /// Exact parent projection prevents a payload from crossing conversations.
  conversation   Conversation @relation(fields: [conversationId, siloId], references: [id, siloId], onDelete: Restrict)

  @@unique([conversationId, authorSubject, idempotencyKey])
  @@index([siloId, conversationId])
  @@map("conversation_private_payloads")
}

/// Holds an encrypted, short-lived LiteLLM attempt key for bootstrap response-loss recovery.
model ConversationComputerAttemptCredential {
  bootstrapId      String   @id @map("bootstrap_id")
  keyAlias         String   @map("key_alias")
  modelAlias       String   @map("model_alias")
  siloId           String   @map("silo_id")
  conversationId   String   @map("conversation_id")
  state             String   @default("pending")
  claimFence        String   @map("claim_fence")
  claimExpiresAt    DateTime @map("claim_expires_at")
  keyId             String?  @map("key_id")
  nonce             Bytes?
  authTag            Bytes?  @map("auth_tag")
  ciphertext         Bytes?
  ciphertextDigest   String? @map("ciphertext_digest")
  credentialDigest  String? @map("credential_digest")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("conversation_computer_attempt_credentials")
}

model ConversationParticipant {
  conversationId        String                      @map("conversation_id")
  userId                String                      @map("user_id")
  visibleFromPosition   BigInt                      @default(0) @map("visible_from_position")
  readThroughPosition   BigInt                      @default(0) @map("read_through_position")
  accessEndedPosition   BigInt?                     @map("access_ended_position")
  archivedAt            DateTime?                   @map("archived_at")
  joinedAt              DateTime                    @default(now()) @map("joined_at")
  conversation          Conversation                @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  assignedElicitations  ElicitationRequest[]

  @@id([conversationId, userId])
  @@index([userId, archivedAt, conversationId])
  @@map("conversation_participants")
}
