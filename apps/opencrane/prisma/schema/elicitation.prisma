/// Durable terminal lifecycle of a participant-input request. Transient submission is owned by a
/// response-attempt row so a process failure cannot strand the request in an ambiguous state.
enum ElicitationRequestState {
  Requested @map("requested")
  Answered  @map("answered")
  Declined  @map("declined")
  Expired   @map("expired")
  Cancelled @map("cancelled")
  Failed    @map("failed")
}

/// Durable state of one caller-idempotent response attempt.
enum ElicitationResponseAttemptState {
  Submitting @map("submitting")
  Accepted   @map("accepted")
  Rejected   @map("rejected")
}

/// Participant interaction shape rendered by every client.
enum ElicitationBodyKind {
  Approval       @map("approval")
  SingleChoice   @map("single_choice")
  MultipleChoice @map("multiple_choice")
  FreeText       @map("free_text")
}

/// Server-owned strategy used after an answer is admitted.
enum ElicitationPurpose {
  RuntimeInput             @map("runtime_input")
  ToolApproval             @map("tool_approval")
  PersonalMemoryPermission @map("personal_memory_permission")
  A2uiAction               @map("a2ui_action")
}

/// One-time result delivery state for the exact paused runtime attempt.
enum ElicitationResultDeliveryState {
  Pending  @map("pending")
  Consumed @map("consumed")
}

/// Canonical participant-input authority. The runtime may propose a body and purpose, but the server
/// derives conversation, run, participant, and expiry coordinates before creating this row.
model ElicitationRequest {
  id                       String                           @id @default(cuid())
  siloId                   String                           @map("silo_id")
  conversationId           String                           @map("conversation_id")
  runId                    String                           @map("run_id")
  attempt                  Int
  assignedParticipantId    String                           @map("assigned_participant_id")
  requestKey               String                           @map("request_key")
  purpose                  ElicitationPurpose
  bodyKind                 ElicitationBodyKind              @map("body_kind")
  body                     Json
  bodyDigest               String                           @map("body_digest")
  purposePayload           Json?                            @map("purpose_payload")
  purposePayloadDigest     String                           @map("purpose_payload_digest")
  state                    ElicitationRequestState          @default(Requested)
  requiresStepUp           Boolean                          @default(false) @map("requires_step_up")
  expiresAt                DateTime                         @map("expires_at")
  resolvedAt               DateTime?                        @map("resolved_at")
  resolvedBy               String?                          @map("resolved_by")
  safeReason               String?                          @map("safe_reason")
  createdAt                DateTime                         @default(now()) @map("created_at")
  conversation             Conversation                     @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  run                      AgentRun                         @relation(fields: [runId, attempt], references: [id, attempt], onDelete: Restrict)
  assignedParticipant      ConversationParticipant          @relation(fields: [conversationId, assignedParticipantId], references: [conversationId, userId], onDelete: Restrict)
  responseAttempts         ElicitationResponseAttempt[]
  resultDelivery           ElicitationResultDelivery?
  toolApproval             ApprovalRequest?
  personalMemoryPermission PersonalMemoryPermissionReceipt?

  @@unique([runId, attempt, requestKey])
  @@unique([id, runId, attempt])
  @@index([conversationId, state, createdAt])
  @@index([assignedParticipantId, state, expiresAt])
  @@index([runId, attempt, state])
  @@map("elicitation_requests")
}

/// One response submission, retained for exact attribution and idempotent conflict detection.
model ElicitationResponseAttempt {
  id                  String                          @id @default(cuid())
  requestId           String                          @map("request_id")
  idempotencyKey      String                          @map("idempotency_key")
  respondingSubjectId String                          @map("responding_subject_id")
  response            Json
  responseDigest      String                          @map("response_digest")
  state               ElicitationResponseAttemptState @default(Submitting)
  verifiedStepUpAt    DateTime?                       @map("verified_step_up_at")
  rejectionReason     String?                         @map("rejection_reason")
  submittedAt         DateTime                        @default(now()) @map("submitted_at")
  completedAt         DateTime?                       @map("completed_at")
  request             ElicitationRequest              @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([requestId, idempotencyKey])
  @@index([requestId, state, submittedAt])
  @@map("elicitation_response_attempts")
}

/// One runtime-resume intent created in the same transaction that terminalises its request.
model ElicitationResultDelivery {
  id            String                         @id @default(cuid())
  requestId     String                         @unique @map("request_id")
  state         ElicitationResultDeliveryState @default(Pending)
  payload       Json?
  payloadDigest String?                        @map("payload_digest")
  createdAt     DateTime                       @default(now()) @map("created_at")
  consumedAt    DateTime?                      @map("consumed_at")
  request       ElicitationRequest             @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([state, createdAt])
  @@map("elicitation_result_deliveries")
}

/// One-use personal-memory permission. It grants one exact invocation from the same run and
/// execution subject; dataset selection remains frozen in the immutable run snapshot.
model PersonalMemoryPermissionReceipt {
  id                         String             @id @default(cuid())
  requestId                  String             @unique @map("request_id")
  runId                      String             @map("run_id")
  attempt                    Int
  subjectId                  String             @map("subject_id")
  executionSubjectId         String             @map("execution_subject_id")
  purposeDigest              String             @map("purpose_digest")
  queryDigest                String             @map("query_digest")
  invocationKey              String             @map("invocation_key")
  consumedByToolInvocationId String?            @unique @map("consumed_by_tool_invocation_id")
  expiresAt                  DateTime           @map("expires_at")
  consumedAt                 DateTime?          @map("consumed_at")
  createdAt                  DateTime           @default(now()) @map("created_at")
  request                    ElicitationRequest @relation(fields: [requestId, runId, attempt], references: [id, runId, attempt], onDelete: Restrict)
  invocation                 ToolInvocation?    @relation(fields: [consumedByToolInvocationId], references: [id], onDelete: Restrict)

  @@unique([runId, attempt, invocationKey])
  @@unique([requestId, runId, attempt])
  @@index([runId, attempt, subjectId, expiresAt])
  @@map("personal_memory_permission_receipts")
}
