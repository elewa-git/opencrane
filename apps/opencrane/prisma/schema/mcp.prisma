enum McpServerTransport {
  StreamableHttp   @map("streamable-http")
  ServerSentEvents @map("sse")
  WebSocket        @map("websocket")
  OciImage         @map("oci-image")
}

enum McpEraProbeStatus {
  NotRequired @map("not-required")
  Pending     @map("pending")
  Accepted    @map("accepted")
  Rejected    @map("rejected")
}

// Records whether an OCI image upload is waiting, imported, or rejected. Absurd owns task attempts;
// this state records the product decision administrators need to read.
enum OciImageValidationState {
  /// The saved workflow has not written an admission decision yet, so a worker may continue it.
  Pending  @map("pending")
  /// Validation and registry import finished; this terminal row stores an immutable image reference.
  Imported @map("imported")
  /// Admission ended without an imported image; this terminal row stores one failure code.
  Rejected @map("rejected")
}

/// Records whether discovery still owes a decision, accepted the pinned protocol and tool schemas,
/// or rejected the revision. The runtime reads this persisted value before admitting invocations;
/// changing a mapped value requires a database migration.
enum McpServerRevisionState {
  /// Discovery still owns the revision, so no invocation may select its tools yet.
  Discovering @map("discovering")
  /// Discovery froze the protocol version and tool schemas, so invocations may now be admitted.
  Ready       @map("ready")
  /// Discovery failed and the revision cannot admit invocations. This state is terminal.
  Rejected    @map("rejected")
}

/// Selects the command saved for one OCI-backed MCP execution. The companion branches on this
/// persisted value, so changing either mapped value requires a database migration.
enum McpRuntimeExecutionKind {
  /// The command checks the protocol revision and freezes live tool schemas for a server revision.
  Discovery  @map("discovery")
  /// The command calls the tool and arguments already admitted by ToolInvocation authority.
  Invocation @map("invocation")
}

/// Tracks which Kubernetes identity the controller has committed for an MCP executor Job. Controller
/// and companion claims branch on this persisted value; changing a mapped value requires a database
/// migration.
enum McpExecutorWorkloadState {
  /// No Job UID is saved yet, so the controller may claim and create a suspended Job.
  Pending    @map("pending")
  /// The suspended Job UID is saved, but Kubernetes has not been told to run it yet.
  Assigned   @map("assigned")
  /// Kubernetes has released the saved Job, but the first owned Pod UID is not saved yet.
  Released   @map("released")
  /// The first owned Pod UID is saved, so that Pod may claim the execution command.
  Registered @map("registered")
  /// The command reached a final or manual-recovery outcome, so no companion may claim it again.
  Closed     @map("closed")
}

/// Tracks whether the registered companion may claim, has claimed, or has finished its command. The
/// runtime persists this value with the companion and ToolInvocation fences; changing a mapped value
/// requires a database migration.
enum McpExecutorCommandState {
  /// No companion holds the command fence, so the registered Pod may claim it.
  Pending          @map("pending")
  /// A companion holds the command fence; an expired invocation must enter recovery instead of running again.
  Claimed          @map("claimed")
  /// The checked result and all paired authority state were saved. This state is terminal.
  Succeeded        @map("succeeded")
  /// Discovery failed or authorization ended before dispatch. This state is terminal.
  Failed           @map("failed")
  /// An invocation may have produced an external effect and now requires manual recovery. This state is terminal.
  RecoveryRequired @map("recovery_required")
}

/// Records the caller-visible state of one durable MCP task. Absurd owns workflow attempts while
/// this row owns input, cancellation, the exact ToolInvocation, and its terminal projection.
enum McpTaskState {
  /// The task is saved but has not yet admitted its exact tool invocation.
  Working          @map("working")
  /// The workflow is waiting for the caller to answer the saved input request.
  InputRequired    @map("input_required")
  /// The exact ToolInvocation and MCP executor work are durably admitted.
  Queued           @map("queued")
  /// The MCP companion holds the provider-effect claim for this task.
  Running          @map("running")
  /// The checked MCP result is saved. This state is terminal.
  Completed        @map("completed")
  /// Cancellation won before provider dispatch. This state is terminal.
  Cancelled        @map("cancelled")
  /// A definite terminal failure is saved. This state is terminal.
  Failed           @map("failed")
  /// Provider outcome is uncertain and operator recovery is required. This state is terminal.
  RecoveryRequired @map("recovery_required")
}

enum McpServerStatus {
  Active   @map("active")
  Degraded @map("degraded")
  Draft    @map("draft")
}

// Consumption shape advertised to the operator API: how a caller connects a
// downstream MCP server (single-user secret, org-wide shared key, or remote OAuth).
enum McpServerType {
  SingleUser  @map("single-user")
  MultiUser   @map("multi-user")
  RemoteOauth @map("remote-oauth")
}

// Governance lifecycle gated by org admins (P1 catalogue review). Only `published`
// servers are visible to entitled callers in the user-facing catalogue.
enum McpApprovalStatus {
  PendingReview @map("pending-review")
  Approved      @map("approved")
  Published     @map("published")
  Disabled      @map("disabled")
}

// Records whether an MCP install awaits external credential activation or is usable through an
// administrator-managed shared key. The operator API returns these persisted values but exposes no
// credential or OAuth activation command; changing either mapped value requires a data migration.
enum McpConnectionStatus {
  // The install remains unusable until a custody flow outside the current API activates it.
  NeedsCredential @map("needs-credential")
  // The install is usable through an administrator-managed key and needs no caller credential.
  SharedKey       @map("shared-key")
}

model McpServer {
  id                     String             @id @default(cuid())
  siloId                 String             @map("silo_id")
  name                   String
  description            String             @default("")
  endpoint               String
  transport              McpServerTransport
  status                 McpServerStatus    @default(Draft)
  requiresApproval       Boolean            @default(false) @map("requires_approval")
  capabilities           String[]           @default([])
  publisher              String?
  glyph                  String?
  serverType             McpServerType      @default(SingleUser) @map("server_type")
  approvalStatus         McpApprovalStatus  @default(PendingReview) @map("approval_status")
  credentialSchema       Json               @default("[]") @map("credential_schema")
  entitlementSummary     String?            @map("entitlement_summary")
  registrationKeyDigest  String?            @map("registration_key_digest")
  registrationDigest     String?            @map("registration_digest")
  eraProbeStatus         McpEraProbeStatus  @default(NotRequired) @map("era_probe_status")
  eraProtocolVersion     String?            @map("era_protocol_version")
  eraProbeEvidenceDigest String?            @map("era_probe_evidence_digest")
  eraProbeFailureCode    String?            @map("era_probe_failure_code")
  eraProbeAttempts       Int                @default(0) @map("era_probe_attempts")
  eraProbedAt            DateTime?          @map("era_probed_at")
  sourceId               String?            @map("source_id")
  lastSyncedAt           DateTime?          @map("last_synced_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  installs               McpServerInstall[]
  revisions              McpServerRevision[]
  source                 ThirdPartySource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([siloId, name])
  @@unique([id, siloId])
  @@unique([siloId, registrationKeyDigest])
  @@index([approvalStatus])
  @@map("mcp_servers")
}

model McpRegistrationClaim {
  siloId         String   @map("silo_id")
  identityDigest String   @map("identity_digest")
  touchedAt      DateTime @updatedAt @map("touched_at")

  @@id([siloId, identityDigest])
  @@map("mcp_registration_claims")
}

// Serializes run admission for one published agent revision without exposing raw SQL to the
// session-assembly layer. The surrounding Serializable transaction still rechecks current MCP
// governance before it commits the frozen run snapshot.
model McpToolAdmissionClaim {
  agentRevisionId String   @map("agent_revision_id")
  siloId          String   @map("silo_id")
  touchedAt       DateTime @updatedAt @map("touched_at")

  @@id([agentRevisionId, siloId])
  @@map("mcp_tool_admission_claims")
}

// Serializes two requests that try to use the same OCI image submission key at the same time.
model OciImageValidationClaim {
  siloId         String   @map("silo_id")
  identityDigest String   @map("identity_digest")
  touchedAt      DateTime @updatedAt @map("touched_at")

  @@id([siloId, identityDigest])
  @@map("oci_image_validation_claims")
}

// Saves the result of checking and importing one immutable OCI image layout.
model OciImageValidation {
  id                      String              @id @default(cuid())
  siloId                  String              @map("silo_id")
  artifactId              String              @map("artifact_id")
  artifactRevisionId      String              @map("artifact_revision_id")
  contentAddress          String              @map("content_address")
  byteLength              BigInt              @map("byte_length")
  mediaType               String              @map("media_type")
  submissionKeyDigest     String              @map("submission_key_digest")
  submissionDigest        String              @map("submission_digest")
  state                   OciImageValidationState @default(Pending)
  indexDigest             String?                 @map("index_digest")
  imageManifestDigest     String?                 @map("image_manifest_digest")
  configDigest            String?                 @map("config_digest")
  registryReference       String?                 @map("registry_reference")
  failureCode             String?             @map("failure_code")
  createdByPrincipalId    String              @map("created_by_principal_id")
  completedAt             DateTime?           @map("completed_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  serverRevision          McpServerRevision?

  @@unique([siloId, submissionKeyDigest])
  @@unique([id, siloId])
  @@index([siloId, state, createdAt])
  @@map("oci_image_validations")
}

/// One immutable OCI image revision after an administrator explicitly promotes its imported image.
model McpServerRevision {
  id                   String                 @id @default(cuid())
  siloId               String                 @map("silo_id")
  mcpServerId          String                 @map("mcp_server_id")
  ociImageValidationId String                 @map("oci_image_validation_id")
  revision             Int
  registryReference    String                 @map("registry_reference")
  protocolVersion      String?                @map("protocol_version")
  state                McpServerRevisionState @default(Discovering)
  completedAt          DateTime?              @map("completed_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  server               McpServer              @relation(fields: [mcpServerId, siloId], references: [id, siloId], onDelete: Restrict)
  validation           OciImageValidation     @relation(fields: [ociImageValidationId, siloId], references: [id, siloId], onDelete: Restrict)
  tools                McpToolRevision[]
  executions           McpRuntimeExecution[]
  tasks                McpTask[]

  @@unique([mcpServerId, revision])
  @@unique([ociImageValidationId, siloId])
  @@unique([siloId, registryReference])
  @@unique([id, siloId])
  @@index([siloId, state])
  @@map("mcp_server_revisions")
}

/// A tool schema frozen from one successful MCP 2026-07-28 discovery exchange.
model McpToolRevision {
  id                    String            @id @default(cuid())
  siloId                String            @map("silo_id")
  serverRevisionId      String            @map("server_revision_id")
  name                  String
  description           String?
  inputSchema           Json              @map("input_schema")
  inputSchemaDigest     String            @map("input_schema_digest")
  createdAt             DateTime          @default(now()) @map("created_at")
  serverRevision        McpServerRevision @relation(fields: [serverRevisionId, siloId], references: [id, siloId], onDelete: Restrict)
  agentRevisionAssignments AgentRevisionMcpToolAssignment[]
  tasks                 McpTask[]

  @@unique([serverRevisionId, name])
  @@unique([id, siloId])
  @@index([siloId, name])
  @@map("mcp_tool_revisions")
}

/// Serializes submissions that reuse one caller-owned MCP task idempotency key.
model McpTaskClaim {
  siloId         String   @map("silo_id")
  identityDigest String   @map("identity_digest")
  touchedAt      DateTime @updatedAt @map("touched_at")

  @@id([siloId, identityDigest])
  @@map("mcp_task_claims")
}

/// One authenticated asynchronous call of an exact tool on an immutable OCI MCP revision.
model McpTask {
  id                  String            @id @default(cuid())
  siloId              String            @map("silo_id")
  principalId         String            @map("principal_id")
  requestKeyDigest    String            @map("request_key_digest")
  callDigest          String            @map("call_digest")
  serverRevisionId    String            @map("server_revision_id")
  toolRevisionId      String            @map("tool_revision_id")
  protocolVersion     String            @map("protocol_version")
  arguments           Json
  taskId              String?           @unique @map("task_id")
  taskName            String?           @map("task_name")
  taskKey             String?           @map("task_key")
  state               McpTaskState      @default(Working)
  inputRequest        Json?             @map("input_request")
  inputResponse       Json?             @map("input_response")
  result              Json?
  failureCode         String?           @map("failure_code")
  cancelRequestedAt   DateTime?         @map("cancel_requested_at")
  completedAt         DateTime?         @map("completed_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  serverRevision      McpServerRevision @relation(fields: [serverRevisionId, siloId], references: [id, siloId], onDelete: Restrict)
  toolRevision        McpToolRevision   @relation(fields: [toolRevisionId, siloId], references: [id, siloId], onDelete: Restrict)
  toolInvocation      ToolInvocation?

  @@unique([siloId, requestKeyDigest])
  @@unique([siloId, taskKey])
  @@index([siloId, principalId, state, createdAt])
  @@map("mcp_tasks")
}

/// Durable claim, Kubernetes assignment, Pod identity, and terminal fence for one MCP executor Job.
model McpRuntimeExecution {
  id                          String                   @id @default(cuid())
  siloId                      String                   @map("silo_id")
  serverRevisionId            String                   @map("server_revision_id")
  toolInvocationId            String?                  @unique @map("tool_invocation_id")
  kind                        McpRuntimeExecutionKind
  workloadState               McpExecutorWorkloadState @default(Pending) @map("workload_state")
  commandState                McpExecutorCommandState @default(Pending) @map("command_state")
  idempotencyKey              String                   @unique @map("idempotency_key")
  executionReference          String                   @unique @map("execution_reference")
  profileName                 String                   @map("profile_name")
  claimedAt                   DateTime?                @map("claimed_at")
  deliveryCount               Int                      @default(0) @map("delivery_count")
  claimExpiresAt              DateTime?                @map("claim_expires_at")
  workloadUid                 String?                  @unique @map("workload_uid")
  assignedAt                  DateTime?                @map("assigned_at")
  releaseClaimedAt            DateTime?                @map("release_claimed_at")
  releaseDeliveryCount        Int                      @default(0) @map("release_delivery_count")
  releaseExpiresAt            DateTime?                @map("release_expires_at")
  releasedAt                  DateTime?                @map("released_at")
  podUid                      String?                  @unique @map("pod_uid")
  companionClaimFence         String?                  @map("companion_claim_fence")
  companionClaimExpiresAt     DateTime?                @map("companion_claim_expires_at")
  toolInvocationClaimFence    Int?                     @map("tool_invocation_claim_fence")
  toolInvocationClaimRevision Int?                     @map("tool_invocation_claim_revision")
  terminalOutcome             String?                  @map("terminal_outcome")
  terminalPayloadDigest       String?                  @map("terminal_payload_digest")
  completedAt                 DateTime?                @map("completed_at")
  cleanupClaimedAt            DateTime?                @map("cleanup_claimed_at")
  cleanupDeliveryCount        Int                      @default(0) @map("cleanup_delivery_count")
  cleanupExpiresAt            DateTime?                @map("cleanup_expires_at")
  cleanupCompletedAt          DateTime?                @map("cleanup_completed_at")
  createdAt                   DateTime                 @default(now()) @map("created_at")
  updatedAt                   DateTime                 @updatedAt @map("updated_at")
  serverRevision              McpServerRevision        @relation(fields: [serverRevisionId, siloId], references: [id, siloId], onDelete: Restrict)
  toolInvocation              ToolInvocation?          @relation(fields: [toolInvocationId], references: [id], onDelete: Restrict)

  @@index([workloadState, claimExpiresAt, createdAt])
  @@index([workloadState, releaseExpiresAt, createdAt])
  @@index([commandState, companionClaimExpiresAt])
  @@index([workloadState, cleanupExpiresAt, createdAt])
  @@index([serverRevisionId, kind])
  @@map("mcp_runtime_executions")
}

/// Database time used by MCP claim and fence checks.
view McpRuntimeClock {
  singleton Int      @unique
  now       DateTime

  @@map("mcp_runtime_clock")
}

/// One pending execution locked by the database for controller claim delivery.
view McpRuntimeClaimCandidate {
  id          String @unique
  siloId      String @map("silo_id")
  profileName String @map("profile_name")

  @@map("mcp_runtime_claim_candidates")
}

/// One assigned execution locked by the database for Job release delivery.
view McpRuntimeReleaseClaimCandidate {
  id          String @unique
  siloId      String @map("silo_id")
  profileName String @map("profile_name")

  @@map("mcp_runtime_release_claim_candidates")
}

// Per-principal installation of an MCP server (operator API).
model McpServerInstall {
  id               String              @id @default(cuid())
  mcpServerId      String              @map("mcp_server_id")
  principalId      String              @map("principal_id")
  connectionStatus McpConnectionStatus @default(NeedsCredential) @map("connection_status")
  lastUsedAt       DateTime?           @map("last_used_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  mcpServer        McpServer           @relation(fields: [mcpServerId], references: [id], onDelete: Restrict)
  principal        Principal           @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@unique([mcpServerId, principalId])
  @@index([principalId])
  @@map("mcp_server_installs")
}
