enum McpServerTransport {
  StreamableHttp   @map("streamable-http")
  ServerSentEvents @map("sse")
  WebSocket        @map("websocket")
}

enum McpEraProbeStatus {
  NotRequired @map("not-required")
  Pending     @map("pending")
  Accepted    @map("accepted")
  Rejected    @map("rejected")
}

// Records whether a saved MCP bundle check is waiting, verified, or rejected. Absurd owns the
// job attempts; this state records only the product decision administrators need to review.
enum McpbValidationState {
  Pending  @map("pending")
  Verified @map("verified")
  Rejected @map("rejected")
}

// Records where one saved MCP bundle validation is in the isolated worker handoff.
enum McpbValidationWorkloadState {
  Pending  @map("pending")
  Claimed  @map("claimed")
  Assigned @map("assigned")
}

enum McpServerStatus {
  Active   @map("active")
  Degraded @map("degraded")
  Draft    @map("draft")
}

// Consumption shape advertised to the operator API: how a caller connects a
// downstream MCP server (single-user secret, org-wide shared key, or remote OAuth).
enum McpServerType {
  SingleUser  @map("single-user")
  MultiUser   @map("multi-user")
  RemoteOauth @map("remote-oauth")
}

// Governance lifecycle gated by org admins (P1 catalogue review). Only `published`
// servers are visible to entitled callers in the user-facing catalogue.
enum McpApprovalStatus {
  PendingReview @map("pending-review")
  Approved      @map("approved")
  Published     @map("published")
  Disabled      @map("disabled")
}

// Records whether an MCP install awaits external credential activation or is usable through an
// administrator-managed shared key. The operator API returns these persisted values but exposes no
// credential or OAuth activation command; changing either mapped value requires a data migration.
enum McpConnectionStatus {
  // The install remains unusable until a custody flow outside the current API activates it.
  NeedsCredential @map("needs-credential")
  // The install is usable through an administrator-managed key and needs no caller credential.
  SharedKey       @map("shared-key")
}

model McpServer {
  id                     String             @id @default(cuid())
  siloId                 String             @map("silo_id")
  name                   String
  description            String             @default("")
  endpoint               String
  transport              McpServerTransport
  status                 McpServerStatus    @default(Draft)
  requiresApproval       Boolean            @default(false) @map("requires_approval")
  capabilities           String[]           @default([])
  publisher              String?
  glyph                  String?
  serverType             McpServerType      @default(SingleUser) @map("server_type")
  approvalStatus         McpApprovalStatus  @default(PendingReview) @map("approval_status")
  credentialSchema       Json               @default("[]") @map("credential_schema")
  entitlementSummary     String?            @map("entitlement_summary")
  registrationKeyDigest  String?            @map("registration_key_digest")
  registrationDigest     String?            @map("registration_digest")
  eraProbeStatus         McpEraProbeStatus  @default(NotRequired) @map("era_probe_status")
  eraProtocolVersion     String?            @map("era_protocol_version")
  eraProbeEvidenceDigest String?            @map("era_probe_evidence_digest")
  eraProbeFailureCode    String?            @map("era_probe_failure_code")
  eraProbeAttempts       Int                @default(0) @map("era_probe_attempts")
  eraProbedAt            DateTime?          @map("era_probed_at")
  sourceId               String?            @map("source_id")
  lastSyncedAt           DateTime?          @map("last_synced_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  installs               McpServerInstall[]
  source                 ThirdPartySource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([siloId, name])
  @@unique([siloId, registrationKeyDigest])
  @@index([approvalStatus])
  @@map("mcp_servers")
}

model McpRegistrationClaim {
  siloId         String   @map("silo_id")
  identityDigest String   @map("identity_digest")
  touchedAt      DateTime @updatedAt @map("touched_at")

  @@id([siloId, identityDigest])
  @@map("mcp_registration_claims")
}

// Serializes two requests that try to use the same bundle submission key at the same time.
model McpbValidationClaim {
  siloId         String   @map("silo_id")
  identityDigest String   @map("identity_digest")
  touchedAt      DateTime @updatedAt @map("touched_at")

  @@id([siloId, identityDigest])
  @@map("mcpb_validation_claims")
}

// Saves the result of checking one immutable MCP bundle before OpenCrane runs or publishes it.
model McpbValidation {
  id                      String              @id @default(cuid())
  siloId                  String              @map("silo_id")
  artifactId              String              @map("artifact_id")
  artifactRevisionId      String              @map("artifact_revision_id")
  contentAddress          String              @map("content_address")
  byteLength              BigInt              @map("byte_length")
  mediaType               String              @map("media_type")
  submissionKeyDigest     String              @map("submission_key_digest")
  submissionDigest        String              @map("submission_digest")
  acceptedManifestVersion String              @default("0.3") @map("accepted_manifest_version")
  state                   McpbValidationState @default(Pending)
  manifestName            String?             @map("manifest_name")
  bundleVersion           String?             @map("bundle_version")
  manifestDigest          String?             @map("manifest_digest")
  publisher               String?
  signerFingerprint       String?             @map("signer_fingerprint")
  failureCode             String?             @map("failure_code")
  createdByPrincipalId    String              @map("created_by_principal_id")
  completedAt             DateTime?           @map("completed_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  workload                McpbValidationWorkload?

  @@unique([siloId, submissionKeyDigest])
  @@index([siloId, state, createdAt])
  @@map("mcpb_validations")
}

// Stores the workflow task admitted for one MCP bundle validation before a controller assigns a
// worker. Its unique task and validation fields let submission retries reuse the same handoff.
model McpbValidationWorkload {
  id             String                       @id @default(cuid())
  siloId         String                       @map("silo_id")
  validationId   String                       @unique @map("validation_id")
  taskId         String                       @unique @map("task_id")
  taskName       String                       @map("task_name")
  taskKey        String                       @map("task_key")
  state          McpbValidationWorkloadState  @default(Pending)
  claimedAt      DateTime?                    @map("claimed_at")
  claimExpiresAt DateTime?                    @map("claim_expires_at")
  deliveryCount  Int                          @default(0) @map("delivery_count")
  workloadUid    String?                      @unique @map("workload_uid")
  workerPodUid   String?                      @unique @map("worker_pod_uid")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")
  validation     McpbValidation               @relation(fields: [validationId], references: [id], onDelete: Restrict)

  @@unique([siloId, taskKey])
  @@index([siloId, state, createdAt])
  @@index([state, claimExpiresAt])
  @@map("mcpb_validation_workloads")
}

// Per-principal installation of an MCP server (operator API).
model McpServerInstall {
  id               String              @id @default(cuid())
  mcpServerId      String              @map("mcp_server_id")
  principalId      String              @map("principal_id")
  connectionStatus McpConnectionStatus @default(NeedsCredential) @map("connection_status")
  lastUsedAt       DateTime?           @map("last_used_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  mcpServer        McpServer           @relation(fields: [mcpServerId], references: [id], onDelete: Restrict)
  principal        Principal           @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@unique([mcpServerId, principalId])
  @@index([principalId])
  @@map("mcp_server_installs")
}
