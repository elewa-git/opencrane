enum PersonalConfigurationChangeState {
  Proposed   @map("proposed")
  Applied    @map("applied")
  Rejected   @map("rejected")
  Superseded @map("superseded")
}

/// Append-only provenance for a personal-agent change that can affect only a later RunInputSnapshot.
model PersonalConfigurationChange {
  id                       String                           @id @default(cuid())
  siloId                   String                           @map("silo_id")
  userId                   String                           @map("user_id")
  personaProfileId         String                           @map("persona_profile_id")
  agentServiceId           String                           @map("agent_service_id")
  sourceThreadId           String                           @map("source_thread_id")
  sourceRunId              String                           @map("source_run_id")
  sourceMessageId          String?                          @map("source_message_id")
  requestedPatch           Json                             @map("requested_patch")
  requestedPatchDigest     String                           @map("requested_patch_digest")
  expectedPersonaRevisionId String?                         @map("expected_persona_revision_id")
  expectedAgentRevisionId  String?                          @map("expected_agent_revision_id")
  appliedPersonaRevisionId String?                          @map("applied_persona_revision_id")
  appliedAgentRevisionId   String?                          @map("applied_agent_revision_id")
  state                    PersonalConfigurationChangeState @default(Proposed)
  proposedAt               DateTime                         @default(now()) @map("proposed_at")
  decidedAt                DateTime?                        @map("decided_at")
  decidedBy                String?                          @map("decided_by")
  rejectionReason          String?                          @map("rejection_reason")

  @@index([siloId, userId, proposedAt])
  @@index([sourceRunId])
  @@index([personaProfileId, state, proposedAt])
  @@map("personal_configuration_changes")
}
