enum SkillState {
  Active  @map("active")
  Retired @map("retired")
}

enum SkillRevisionState {
  Draft     @map("draft")
  Review    @map("review")
  Published @map("published")
  Rejected  @map("rejected")
  Revoked   @map("revoked")
}

enum SkillTrustClass {
  ReviewedInstructions @map("reviewed_instructions")
  SandboxedPython      @map("sandboxed_python")
}

/// Isolated Job class selected by the durable skill-work authority.
enum SkillWorkloadKind {
  Authoring  @map("authoring")
  ToolRunner @map("tool_runner")
}

/// Durable disposition before controller assignment and worker reply are introduced.
enum SkillWorkloadState {
  Pending    @map("pending")
  Assigned   @map("assigned")
  Cancelled  @map("cancelled")
}

model Skill {
  id                String       @id @default(cuid())
  siloId            String       @map("silo_id")
  ownerPrincipalId  String       @map("owner_principal_id")
  name              String
  description       String       @default("")
  state             SkillState   @default(Active)
  currentRevisionId String?      @map("current_revision_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  revisions         SkillRevision[] @relation("SkillRevisions")
  currentRevision   SkillRevision?  @relation("CurrentSkillRevision", fields: [id, currentRevisionId], references: [skillId, id], onDelete: Restrict)

  @@unique([id, currentRevisionId])
  @@unique([siloId, ownerPrincipalId, name])
  @@index([siloId, state])
  @@map("skills")
}

model SkillRevision {
  id                     String             @id @default(cuid())
  skillId                String             @map("skill_id")
  revision               Int
  state                  SkillRevisionState @default(Draft)
  artifactId             String             @map("artifact_id")
  artifactRevisionId     String             @map("artifact_revision_id")
  artifactContentAddress String             @map("artifact_content_address")
  manifest               Json
  requirements           Json
  testReport             Json?              @map("test_report")
  scanResult             Json?              @map("scan_result")
  trustClass             SkillTrustClass    @map("trust_class")
  signature              String?
  signerKeyId            String?            @map("signer_key_id")
  authoredBy             String             @map("authored_by")
  reviewedBy             String?            @map("reviewed_by")
  createdAt              DateTime           @default(now()) @map("created_at")
  publishedAt            DateTime?          @map("published_at")
  revokedAt              DateTime?          @map("revoked_at")
  skill                  Skill              @relation("SkillRevisions", fields: [skillId], references: [id], onDelete: Restrict)
  currentFor             Skill[]            @relation("CurrentSkillRevision")
  workloads              SkillWorkload[]

  @@unique([skillId, revision])
  @@unique([skillId, id])
  @@unique([id, artifactRevisionId, artifactContentAddress])
  @@index([artifactRevisionId])
  @@index([state, trustClass])
  @@map("skill_revisions")
}

/// One canonical future Job request, never a Kubernetes queue or worker-owned receipt.
model SkillWorkload {
  id               String             @id @default(cuid())
  siloId           String             @map("silo_id")
  kind             SkillWorkloadKind
  state            SkillWorkloadState @default(Pending)
  skillRevisionId  String             @map("skill_revision_id")
  toolInvocationId String?            @unique @map("tool_invocation_id")
  claimedAt        DateTime?          @map("claimed_at")
  deliveryCount    Int                @default(0) @map("delivery_count")
  workloadUid      String?            @unique @map("workload_uid")
  createdAt        DateTime           @default(now()) @map("created_at")
  cancelledAt      DateTime?          @map("cancelled_at")
  skillRevision    SkillRevision      @relation(fields: [skillRevisionId], references: [id], onDelete: Restrict)
  toolInvocation   ToolInvocation?    @relation(fields: [toolInvocationId], references: [id], onDelete: Restrict)
  bootstrap        SkillWorkloadBootstrap?

  @@index([siloId, state, createdAt])
  @@map("skill_workloads")
}

/// One hashed, one-use worker bootstrap bound to an assigned governed skill Job.
model SkillWorkloadBootstrap {
  id                 String        @id @default(cuid())
  skillWorkloadId    String        @unique @map("skill_workload_id")
  referenceHash      String        @unique @map("reference_hash")
  audience           String
  serviceAccountName String        @map("service_account_name")
  namespace          String
  workloadUid        String        @map("workload_uid")
  expiresAt          DateTime      @map("expires_at")
  consumedAt         DateTime?     @map("consumed_at")
  consumedByPodUid   String?       @map("consumed_by_pod_uid")
  createdAt          DateTime      @default(now()) @map("created_at")
  skillWorkload      SkillWorkload @relation(fields: [skillWorkloadId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("skill_workload_bootstraps")
}
