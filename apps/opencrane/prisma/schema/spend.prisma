model TokenUsageSnapshot {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  totalTokens  Int      @default(0) @map("total_tokens")
  currency     String
  totalCost    Decimal  @map("total_cost") @db.Decimal(12, 4)
  sampledAt    DateTime @default(now()) @map("sampled_at")

  @@unique([userId, currency])
  @@index([sampledAt])
  @@map("token_usage_snapshots")
}

model GlobalBudgetSetting {
  id            Int      @id @default(1)
  currency      String
  ceilingAmount Decimal  @map("ceiling_amount") @db.Decimal(12, 2)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("global_budget_settings")
}

model AccountBudgetSetting {
  userId        String   @id @map("user_id")
  currency      String
  ceilingAmount Decimal  @map("ceiling_amount") @db.Decimal(12, 2)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("account_budget_settings")
}
