{
  "name": "skill-authoring",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "metadata": { "release": { "adaptedVersion": "0.8.0" } },
  "sourceRoot": "apps/skill-authoring",
  "tags": ["type:app", "layer:entrypoint", "scope:skill-authoring"],
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "python3 -B -c 'import ast, pathlib; [ast.parse(pathlib.Path(path).read_text()) for path in [\"libs/backend/agents/skills/worker/src/bootstrap.py\", \"apps/skill-authoring/src/authoring_worker.py\"]]'", "cwd": "." } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "helm template skill-authoring helm >/dev/null", "cwd": "apps/skill-authoring" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "python3 -B -m unittest discover -s apps/skill-authoring/__tests__ && bash apps/skill-authoring/tests/helm-contract.sh && bash apps/skill-authoring/tests/image-contract.sh", "cwd": "." } },
    "container": {
      "executor": "nx:run-commands",
      "metadata": {
        "release": {
          "image": "opencrane-skill-authoring",
          "dockerfile": "apps/skill-authoring/deploy/Dockerfile"
        }
      },
      "options": { "command": "docker build -f apps/skill-authoring/deploy/Dockerfile ." }
    },
    "image-smoke": {
      "executor": "nx:run-commands",
      "options": { "command": "bash apps/skill-authoring/tests/image-smoke.sh", "cwd": "." }
    }
  }
}
