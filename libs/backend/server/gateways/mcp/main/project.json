{
  "name": "backend-server-mcp",
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/backend/server/gateways/mcp/main/src",
  "tags": [
    "type:lib",
    "layer:backend",
    "scope:mcp"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "libs/backend/server/gateways/mcp/main"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests --exclude '**/*.sql.test.ts'",
        "cwd": "libs/backend/server/gateways/mcp/main"
      }
    },
    "test:sql": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --no-file-parallelism src/connections/__tests__/mcp-connection-readiness.sql.test.ts src/connections/discovery/__tests__/mcp-remote-revision-finalization.sql.test.ts src/runtime/__tests__/remote-mcp-dispatch-authority.sql.test.ts",
        "cwd": "libs/backend/server/gateways/mcp/main"
      }
    }
  }
}
