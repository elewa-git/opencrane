{
	"name": "frontend-elements-ui",
	"$schema": "../../../../node_modules/nx/schemas/project-schema.json",
	"projectType": "library",
	"sourceRoot": "libs/frontend/elements/ui/src",
	"prefix": "wo",
	"tags": [
		"scope:shared",
		"type:lib",
		"layer:frontend",
		"frontend-role:elements"
	],
	"targets": {
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p tsconfig.lint.json",
				"cwd": "libs/frontend/elements/ui"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run --passWithNoTests",
				"cwd": "libs/frontend/elements/ui"
			}
		},
		"storybook": {
			"executor": "@storybook/angular:start-storybook",
			"inputs": [
				"default",
				"^production",
				"{workspaceRoot}/libs/frontend/core/src/lib/theme/opencrane-theme.scss"
			],
			"options": {
				"browserTarget": "frontend-elements-ui:build-storybook",
				"configDir": "libs/frontend/elements/ui/.storybook",
				"tsConfig": "libs/frontend/elements/ui/.storybook/tsconfig.json",
				"styles": [
					"libs/frontend/core/src/lib/theme/opencrane-theme.scss"
				],
				"port": 4400,
				"host": "127.0.0.1",
				"compodoc": false,
				"experimentalZoneless": true
			},
			"configurations": {
				"ci": {
					"ci": true,
					"quiet": true
				}
			}
		},
		"build-storybook": {
			"executor": "@storybook/angular:build-storybook",
			"inputs": [
				"default",
				"^production",
				"{workspaceRoot}/libs/frontend/core/src/lib/theme/opencrane-theme.scss"
			],
			"outputs": [
				"{options.outputDir}"
			],
			"options": {
				"browserTarget": "frontend-elements-ui:build-storybook",
				"configDir": "libs/frontend/elements/ui/.storybook",
				"tsConfig": "libs/frontend/elements/ui/.storybook/tsconfig.json",
				"styles": [
					"libs/frontend/core/src/lib/theme/opencrane-theme.scss"
				],
				"outputDir": "dist/storybook/frontend-elements-ui",
				"compodoc": false,
				"experimentalZoneless": true
			},
			"configurations": {
				"ci": {
					"quiet": true
				}
			}
		},
		"static-storybook": {
			"executor": "@nx/web:file-server",
			"continuous": true,
			"cache": false,
			"dependsOn": [
				"build-storybook"
			],
			"options": {
				"staticFilePath": "dist/storybook/frontend-elements-ui",
				"port": 4400,
				"host": "127.0.0.1",
				"watch": false,
				"cors": false,
				"cacheSeconds": -1
			}
		},
		"test-storybook": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": [
				"static-storybook"
			],
			"options": {
				"command": "wait-on --timeout 60000 http-get://127.0.0.1:4400/index.json && test-storybook --config-dir libs/frontend/elements/ui/.storybook --url http://127.0.0.1:4400 --index-json --ci --failOnConsole --maxWorkers=1 --disable-telemetry"
			}
		},
		"test-storybook-visual": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": [
				"static-storybook"
			],
			"inputs": [
				"default",
				"^production",
				"{workspaceRoot}/playwright.storybook.config.ts",
				"{workspaceRoot}/tests/storybook/**/*"
			],
			"outputs": [
				"{workspaceRoot}/.nx/test-results/storybook"
			],
			"options": {
				"command": "wait-on --timeout 60000 http-get://127.0.0.1:4400/index.json && playwright test --config playwright.storybook.config.ts"
			}
		},
		"update-storybook-visual": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": [
				"static-storybook"
			],
			"options": {
				"command": "wait-on --timeout 60000 http-get://127.0.0.1:4400/index.json && playwright test --config playwright.storybook.config.ts --update-snapshots=all"
			}
		}
	}
}
