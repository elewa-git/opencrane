{
	"name": "frontend-gateways",
	"$schema": "../../../../node_modules/nx/schemas/project-schema.json",
	"projectType": "library",
	"sourceRoot": "libs/frontend/state/gateways/src",
	"prefix": "wo",
	"tags": [
		"scope:web",
		"layer:frontend",
		"type:lib"
	],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": [
				"{workspaceRoot}/dist/libs/frontend/state/gateways"
			],
			"options": {
				"commands": [
					"tsc -p tsconfig.lint.json",
					"esbuild src/index.ts --bundle --format=esm --platform=browser --packages=external --sourcemap --outfile=../../../../dist/libs/frontend/state/gateways/index.js"
				],
				"cwd": "libs/frontend/state/gateways",
				"parallel": false
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc -p tsconfig.lint.json",
				"cwd": "libs/frontend/state/gateways"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run --passWithNoTests",
				"cwd": "libs/frontend/state/gateways"
			}
		}
	}
}
