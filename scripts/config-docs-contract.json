        { "path": "artifactService", "owner": "apps/artifact-service/helm" },
        { "path": "artifactPreprocessor", "owner": "apps/artifact-preprocessor/helm" },
        { "path": "artifactScanner", "owner": "apps/artifact-scanner/helm" },
        { "path": "managedAgentRuntimePlane", "owner": "apps/managed-agent-runtime/helm" },
        { "path": "agentController", "owner": "apps/agent-controller/helm" },
        { "path": "clustertenantManager", "owner": "apps/opencrane/helm" },
        { "path": "litellm", "owner": "apps/_infra/litellm/helm" },
        { "path": "mcpGateway", "owner": "apps/_infra/obot/helm" },
        { "path": "controlPlaneSpa", "owner": "apps/opencrane-ui/helm" },
        { "path": "docs", "owner": "apps/_infra/deploy-k8s/templates" }
      ],
      "internalKeys": [
        { "path": "nameOverride", "reason": "Release-name helper input; it is not an operator configuration surface." }
      ]
    }
  ]
