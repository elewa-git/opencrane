{
  "version": 1,
  "charts": [
    {
      "path": "apps/_infra/deploy-k8s",
      "operatorInputs": [
        { "path": "global", "documentation": "website/operators/deployment-configuration.md" },
        { "path": "multiCt", "documentation": "website/operators/deployment-configuration.md" },
        { "path": "crds", "documentation": "website/operators/deployment-configuration.md" },
        { "path": "multiInstance", "documentation": "website/operators/deployment-configuration.md" },
        { "path": "sharedPlatform", "documentation": "website/operators/deployment-configuration.md" },
        { "path": "ingress", "documentation": "website/operators/deployment-configuration.md" },
        { "path": "certManager", "documentation": "website/operators/deployment-configuration.md" },
        { "path": "networkPolicy", "documentation": "website/operators/deployment-configuration.md" },
        { "path": "externalSecrets", "documentation": "website/operators/deployment-configuration.md" },
        { "path": "observability", "documentation": "website/operators/deployment-configuration.md" }
      ],
      "forwardedKeys": [
        { "path": "channelProxy", "owner": "apps/channel-proxy/helm" },
        { "path": "memoryGateway", "owner": "apps/memory-gateway/helm" },
        { "path": "opencrane-skill-authoring", "owner": "apps/skill-authoring/helm" },
